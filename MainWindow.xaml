<Window x:Class="币安量化机器人.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cc="clr-namespace:币安量化机器人.Controls"
        Title="{DynamicResource App.Title}" MinWidth="1280" MinHeight="800"
        Width="1600" Height="980" FontFamily="Segoe UI, Microsoft YaHei"
        WindowStartupLocation="CenterScreen" Background="#050A10" Foreground="#E8F4FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Cyan" Color="#18D8F2"/><SolidColorBrush x:Key="Green" Color="#35E6A0"/>
        <SolidColorBrush x:Key="Orange" Color="#FFAA4C"/><SolidColorBrush x:Key="Red" Color="#FF5370"/>
        <SolidColorBrush x:Key="Muted" Color="#7895A6"/><SolidColorBrush x:Key="Card" Color="#C9101B25"/>
        <Style TargetType="ToolTip"><Setter Property="Background" Value="#101D28"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#244355"/><Setter Property="Padding" Value="9"/></Style>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CDE8F3"/><Setter Property="Background" Value="#101E29"/><Setter Property="BorderBrush" Value="#294658"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="5,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#173344"/><Setter TargetName="B" Property="BorderBrush" Value="#18D8F2"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="16,12"/><Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="#203B4B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="7"/><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#001018" BlurRadius="22" ShadowDepth="7" Opacity=".55"/></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#3B7892"/><Setter Property="Background" Value="#E0132330"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="DraggableCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Card_MouseDown"/><EventSetter Event="PreviewMouseMove" Handler="Card_MouseMove"/><EventSetter Event="Drop" Handler="Card_Drop"/><Setter Property="AllowDrop" Value="True"/>
        </Style>
        <Style x:Key="StatusPill" TargetType="Border"><Setter Property="Background" Value="#0D1821"/><Setter Property="BorderBrush" Value="#1D3543"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="4,0"/></Style>
        <Style x:Key="SignalBar" TargetType="ProgressBar"><Setter Property="Height" Value="7"/><Setter Property="Maximum" Value="100"/><Setter Property="Background" Value="#142630"/><Setter Property="Foreground" Value="{StaticResource Cyan}"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style x:Key="WorkflowNode" TargetType="Border"><Setter Property="Background" Value="#0D1922"/><Setter Property="BorderBrush" Value="#28414F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="12,11"/><Setter Property="Margin" Value="3"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.Background><RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="1.1" RadiusY="1.1"><GradientStop Color="#10283A" Offset="0"/><GradientStop Color="#07111A" Offset=".42"/><GradientStop Color="#04080D" Offset="1"/></RadialGradientBrush></Grid.Background>
        <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E9071119" BorderBrush="#18303F" BorderThickness="0,0,0,1" Padding="22,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Grid Width="42" Height="42"><Ellipse Fill="#0D2936" Stroke="#18D8F2" StrokeThickness="1"/><Ellipse Width="12" Height="12" Fill="#18D8F2"><Ellipse.Effect><DropShadowEffect Color="#18D8F2" BlurRadius="18" ShadowDepth="0"/></Ellipse.Effect></Ellipse></Grid><StackPanel Margin="12,0,0,0"><TextBlock Text="{DynamicResource Brand.Name}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Brand.Subtitle}" Foreground="#5F92A9" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="AiDot" Width="7" Height="7" Fill="#35E6A0" Margin="0,0,7,0"/><TextBlock x:Name="AiStatusText" Text="{DynamicResource Status.AiStandby}" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource StatusPill}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#35E6A0" Margin="0,0,7,0"/><TextBlock x:Name="BrainStatusText" Text="{DynamicResource Status.BrainReady}" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource StatusPill}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#18D8F2" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource Status.Testnet}" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource StatusPill}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#35E6A0" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource Status.MemoryLoaded}" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource StatusPill}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="RuntimeDot" Width="7" Height="7" Fill="#FFAA4C" Margin="0,0,7,0"/><TextBlock x:Name="RuntimeStatusText" Text="{DynamicResource Status.RuntimeStandby}" FontSize="11"/></StackPanel></Border>
                    <Border Style="{StaticResource StatusPill}"><TextBlock Text="{DynamicResource Status.SkillsOnline}" FontSize="11" Foreground="#8BCDE2"/></Border>
                    <Border Style="{StaticResource StatusPill}"><TextBlock x:Name="UserStatusText" FontSize="11" Foreground="#8BCDE2"/></Border>
                    <Border Style="{StaticResource StatusPill}"><TextBlock x:Name="ExchangeStatusText" FontSize="11"/></Border>
                    <Border Style="{StaticResource StatusPill}"><TextBlock x:Name="PermissionStatusText" FontSize="11"/></Border>
                    <Border Style="{StaticResource StatusPill}"><TextBlock x:Name="RiskReadyStatusText" FontSize="11"/></Border>
                </WrapPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="LanguageButton" Style="{StaticResource CommandButton}" Content="{DynamicResource Language.Button}" Click="LanguageButton_Click"/><Button x:Name="SettingsButton" Style="{StaticResource CommandButton}" Content="{DynamicResource Access.Settings}" Click="Settings_Click"/><Button x:Name="StartButton" Style="{StaticResource CommandButton}" Content="{DynamicResource Command.Initialize}" Click="StartAgent_Click"/><Button x:Name="PauseButton" Style="{StaticResource CommandButton}" Content="{DynamicResource Command.Pause}" IsEnabled="False" Click="PauseAgent_Click"/><Button x:Name="StopButton" Style="{StaticResource CommandButton}" Content="{DynamicResource Command.Stop}" IsEnabled="False" Click="StopAgent_Click"/><Button x:Name="EmergencyButton" Style="{StaticResource CommandButton}" Content="{DynamicResource Command.EmergencyClose}" Foreground="#FF7C91" BorderBrush="#7E3040" Click="EmergencyClose_Click"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#09131B" BorderBrush="#162C39" BorderThickness="0,0,0,1" Padding="22,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#18D8F2" FontSize="9"/><TextBlock x:Name="StageText" Text="{DynamicResource Stage.Idle}" Foreground="#9BC9DA" FontSize="11" Margin="4,0,22,0"/><TextBlock Text="{DynamicResource Label.LastDecision}" Foreground="#4E7487" FontSize="10"/><TextBlock x:Name="LastDecisionText" Text="HOLD" Foreground="#FFAA4C" FontWeight="SemiBold" FontSize="11" Margin="5,0,22,0"/><TextBlock Text="{DynamicResource Label.Market}" Foreground="#4E7487" FontSize="10"/><TextBlock x:Name="RegimeText" Text="" Foreground="#18D8F2" FontSize="11" Margin="5,0,22,0"/><TextBlock Text="{DynamicResource Label.Reflection}" Foreground="#4E7487" FontSize="10"/><TextBlock x:Name="ReflectionText" Text="{DynamicResource Status.MemoryLoaded}" Foreground="#35E6A0" FontSize="11" Margin="5,0,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Label.NextCycle}" Foreground="#4E7487" FontSize="10"/><TextBlock x:Name="CycleText" Text="--:--" Foreground="#18D8F2" FontFamily="Consolas" FontSize="13" Margin="8,0,20,0"/><TextBlock x:Name="ClockText" Foreground="#7895A6" FontFamily="Consolas" FontSize="11"/></StackPanel></Grid></Border>

        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#B2071017" BorderBrush="#17303C" BorderThickness="0,0,1,0" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Nav.Kicker}" Foreground="#4F8095" FontSize="10" Margin="8,10,0,12"/><StackPanel Grid.Row="1"><Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav.CommandCenter}" Tag="HOME" Click="NavButton_Click"/><Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav.MarketPulse}" Tag="MARKET" Click="NavButton_Click"/><Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav.Positions}" Tag="POSITIONS" Click="NavButton_Click"/><Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav.Risk}" Tag="RISK" Click="NavButton_Click"/><Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav.BrainMemory}" Tag="BRAIN" Click="NavButton_Click"/><Button Style="{StaticResource NavButton}" Content="{DynamicResource Nav.Events}" Tag="LOGS" Click="NavButton_Click"/></StackPanel><Border Grid.Row="2" Background="#0C1B24" BorderBrush="#1D3C4A" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="{DynamicResource Network.Title}" Foreground="#4F8095" FontSize="9"/><TextBlock Text="{DynamicResource Network.Exchange}" Margin="0,5,0,0" FontSize="11"/><TextBlock Text="{DynamicResource Network.Mode}" Foreground="#35E6A0" FontSize="10" Margin="0,3,0,0"/><Separator Background="#19313D" Margin="0,10"/><TextBlock x:Name="AccountSideText" Text="0.00 USDT" FontFamily="Consolas" FontSize="16"/><TextBlock Text="{DynamicResource Network.EquityOnline}" Foreground="#5C8293" FontSize="9"/></StackPanel></Border></Grid></Border>

            <Grid Grid.Column="1" x:Name="DashboardPage"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="12"><Grid Margin="8,8,8,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Dashboard.Title}" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Dashboard.Subtitle}" Foreground="#688B9C" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Label.Thinking}" Foreground="#5E8496" FontSize="10"/><ProgressBar x:Name="ThinkingBar" Width="150" Height="5" Margin="10,0" Style="{StaticResource SignalBar}"/><TextBlock x:Name="ThinkingPercent" Text="0%" Foreground="#18D8F2" FontFamily="Consolas"/></StackPanel></Grid>
                    <WrapPanel x:Name="DashboardCards">
                        <Border Tag="BRAIN" Style="{StaticResource DraggableCard}" Width="720" Height="260"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Brain.Title}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Brain.Live}" HorizontalAlignment="Right" Foreground="#35E6A0" FontSize="9"/></Grid><UniformGrid Grid.Row="1" Columns="4" Margin="0,8,0,0"><cc:RadialGauge x:Name="ConfidenceGauge" Caption="{DynamicResource Brain.Confidence}" Accent="#18D8F2"/><cc:RadialGauge x:Name="DecisionGauge" Caption="{DynamicResource Brain.DecisionScore}" Accent="#35E6A0"/><cc:RadialGauge x:Name="RiskGauge" Caption="{DynamicResource Brain.RiskLoad}" Accent="#FFAA4C"/><cc:RadialGauge x:Name="ConflictGauge" Caption="{DynamicResource Brain.ConflictRate}" Accent="#FF5370"/></UniformGrid></Grid></Border>
                        <Border Tag="THOUGHT" Style="{StaticResource DraggableCard}" Width="510" Height="260"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Brain.Activity}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Common.Live}" Foreground="#35E6A0" FontSize="9" HorizontalAlignment="Right"/></Grid><ListBox x:Name="ThoughtList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#AFC9D5" FontFamily="Consolas" FontSize="11" Margin="-4,10,-4,0" IsHitTestVisible="False"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="0,4"><TextBlock Text="›" Foreground="#18D8F2" Margin="0,0,8,0"/><TextBlock Text="{Binding}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                        <Border Tag="MARKETS" Style="{StaticResource DraggableCard}" Width="610" Height="255"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Market.Title}" FontWeight="SemiBold"/><TextBlock x:Name="MarketStateText" HorizontalAlignment="Right" Foreground="#18D8F2" FontSize="10"/></Grid><Grid Grid.Row="1" Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#0A151D" BorderBrush="#1A3947" BorderThickness="1" CornerRadius="9" Padding="15"><StackPanel><Grid><TextBlock Text="BTC / USDT" FontWeight="SemiBold"/><TextBlock x:Name="BtcDirection" HorizontalAlignment="Right" Foreground="#FFAA4C" FontSize="10"/></Grid><TextBlock x:Name="BtcPriceText" Text="--" FontFamily="Consolas" FontSize="25" Margin="0,12,0,3"/><TextBlock x:Name="BtcMetaText" Text="RSI --  •  --" Foreground="#7395A5"/><UniformGrid Columns="8" Margin="0,15,0,0"><Border Height="14" Margin="2" Background="#173B44"/><Border Margin="2" Background="#1E5360"/><Border Margin="2" Background="#16828A"/><Border Margin="2" Background="#1AB7AD"/><Border Margin="2" Background="#1AB7AD"/><Border Margin="2" Background="#16828A"/><Border Margin="2" Background="#1E5360"/><Border Margin="2" Background="#173B44"/></UniformGrid></StackPanel></Border><Border Grid.Column="2" Background="#0A151D" BorderBrush="#1A3947" BorderThickness="1" CornerRadius="9" Padding="15"><StackPanel><Grid><TextBlock Text="ETH / USDT" FontWeight="SemiBold"/><TextBlock x:Name="EthDirection" HorizontalAlignment="Right" Foreground="#FFAA4C" FontSize="10"/></Grid><TextBlock x:Name="EthPriceText" Text="--" FontFamily="Consolas" FontSize="25" Margin="0,12,0,3"/><TextBlock x:Name="EthMetaText" Text="RSI --  •  --" Foreground="#7395A5"/><UniformGrid Columns="8" Margin="0,15,0,0"><Border Height="14" Margin="2" Background="#35263A"/><Border Margin="2" Background="#4B2B43"/><Border Margin="2" Background="#704054"/><Border Margin="2" Background="#A85464"/><Border Margin="2" Background="#A85464"/><Border Margin="2" Background="#704054"/><Border Margin="2" Background="#4B2B43"/><Border Margin="2" Background="#35263A"/></UniformGrid></StackPanel></Border></Grid></Grid></Border>
                        <Border Tag="FLOW" Style="{StaticResource DraggableCard}" Width="620" Height="255"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Workflow.Title}" FontWeight="SemiBold"/><TextBlock x:Name="WorkflowStateText" Text="{DynamicResource Workflow.Idle}" HorizontalAlignment="Right" Foreground="#18D8F2" FontFamily="Consolas"/></Grid><UniformGrid Grid.Row="1" Columns="7" Margin="0,20,0,0"><Border x:Name="NodeObservation" Style="{StaticResource WorkflowNode}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="01" Foreground="#52788A"/><TextBlock Text="{DynamicResource Workflow.Observe}" Margin="0,12,0,0" FontSize="10"/></StackPanel></Border><Border x:Name="NodePlanner" Style="{StaticResource WorkflowNode}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="02" Foreground="#52788A"/><TextBlock Text="{DynamicResource Workflow.Planner}" Margin="0,12,0,0" FontSize="10"/></StackPanel></Border><Border x:Name="NodeCritic" Style="{StaticResource WorkflowNode}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="03" Foreground="#52788A"/><TextBlock Text="{DynamicResource Workflow.Critic}" Margin="0,12,0,0" FontSize="10"/></StackPanel></Border><Border x:Name="NodeReviewer" Style="{StaticResource WorkflowNode}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="04" Foreground="#52788A"/><TextBlock Text="{DynamicResource Workflow.Reviewer}" Margin="0,12,0,0" FontSize="10"/></StackPanel></Border><Border x:Name="NodeRisk" Style="{StaticResource WorkflowNode}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="05" Foreground="#52788A"/><TextBlock Text="{DynamicResource Workflow.Risk}" Margin="0,12,0,0" FontSize="10"/></StackPanel></Border><Border x:Name="NodeExecution" Style="{StaticResource WorkflowNode}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="06" Foreground="#52788A"/><TextBlock Text="{DynamicResource Workflow.Execute}" Margin="0,12,0,0" FontSize="10"/></StackPanel></Border><Border x:Name="NodeReflection" Style="{StaticResource WorkflowNode}"><StackPanel HorizontalAlignment="Center"><TextBlock Text="07" Foreground="#52788A"/><TextBlock Text="{DynamicResource Workflow.Reflect}" Margin="0,12,0,0" FontSize="10"/></StackPanel></Border></UniformGrid></Grid></Border>
                        <Border Tag="SIGNALS" Style="{StaticResource DraggableCard}" Width="610" Height="290"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Signal.Title}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Signal.Contribution}" HorizontalAlignment="Right" Foreground="#55798A" FontSize="9"/></Grid><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="55"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="{DynamicResource Signal.Trend15m}"/><TextBlock Grid.Row="1" Text="{DynamicResource Signal.Trend1h}"/><TextBlock Grid.Row="2" Text="{DynamicResource Signal.Trend4h}"/><TextBlock Grid.Row="3" Text="{DynamicResource Signal.Rsi}"/><TextBlock Grid.Row="4" Text="{DynamicResource Signal.OrderFlow}"/><TextBlock Grid.Row="5" Text="{DynamicResource Signal.Funding}"/><TextBlock Grid.Row="6" Text="{DynamicResource Signal.OiCrowd}"/><TextBlock Grid.Row="7" Text="{DynamicResource Signal.BasisNews}"/><ProgressBar x:Name="Signal15m" Grid.Column="1" Style="{StaticResource SignalBar}"/><ProgressBar x:Name="Signal1h" Grid.Row="1" Grid.Column="1" Style="{StaticResource SignalBar}"/><ProgressBar x:Name="Signal4h" Grid.Row="2" Grid.Column="1" Style="{StaticResource SignalBar}"/><ProgressBar x:Name="SignalRsi" Grid.Row="3" Grid.Column="1" Style="{StaticResource SignalBar}"/><ProgressBar x:Name="SignalFlow" Grid.Row="4" Grid.Column="1" Style="{StaticResource SignalBar}"/><ProgressBar x:Name="SignalFunding" Grid.Row="5" Grid.Column="1" Style="{StaticResource SignalBar}"/><ProgressBar x:Name="SignalOi" Grid.Row="6" Grid.Column="1" Style="{StaticResource SignalBar}"/><ProgressBar x:Name="SignalNews" Grid.Row="7" Grid.Column="1" Style="{StaticResource SignalBar}"/><TextBlock x:Name="Signal15mValue" Grid.Column="2" HorizontalAlignment="Right"/><TextBlock x:Name="Signal1hValue" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right"/><TextBlock x:Name="Signal4hValue" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right"/><TextBlock x:Name="SignalRsiValue" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right"/><TextBlock x:Name="SignalFlowValue" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right"/><TextBlock x:Name="SignalFundingValue" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Right"/><TextBlock x:Name="SignalOiValue" Grid.Row="6" Grid.Column="2" HorizontalAlignment="Right"/><TextBlock x:Name="SignalNewsValue" Grid.Row="7" Grid.Column="2" HorizontalAlignment="Right"/></Grid></Grid></Border>
                        <Border Tag="PORTFOLIO" Style="{StaticResource DraggableCard}" Width="620" Height="290"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Portfolio.Title}" FontWeight="SemiBold"/><TextBlock x:Name="ExposureText" Text="" HorizontalAlignment="Right" Foreground="#35E6A0" FontSize="10"/></Grid><UniformGrid Grid.Row="1" Columns="4" Margin="0,12,0,4"><StackPanel><TextBlock Text="{DynamicResource Portfolio.Equity}" Foreground="#55798A" FontSize="9"/><TextBlock x:Name="EquityText" Text="0.00" FontFamily="Consolas" FontSize="20" Margin="0,7,0,0"/><TextBlock Text="USDT" Foreground="#55798A" FontSize="9"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Portfolio.Available}" Foreground="#55798A" FontSize="9"/><TextBlock x:Name="AvailableText" Text="0.00" FontFamily="Consolas" FontSize="20" Margin="0,7,0,0"/><TextBlock Text="USDT" Foreground="#55798A" FontSize="9"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Portfolio.Position}" Foreground="#55798A" FontSize="9"/><TextBlock x:Name="PositionText" Text="{DynamicResource Portfolio.Flat}" FontFamily="Consolas" FontSize="20" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource Portfolio.Hedge}" Foreground="#55798A" FontSize="9"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Portfolio.Evidence}" Foreground="#55798A" FontSize="9"/><TextBlock x:Name="EvidenceText" Text="0" FontFamily="Consolas" FontSize="20" Margin="0,7,0,0"/><TextBlock Text="{DynamicResource Portfolio.Quality}" Foreground="#55798A" FontSize="9"/></StackPanel></UniformGrid><cc:SparklineChart x:Name="EquityChart" Grid.Row="2" Accent="#35E6A0" Margin="0,8,0,0"/></Grid></Border>
                    </WrapPanel>
                </StackPanel></ScrollViewer></Grid>

            <Grid Grid.Column="1" x:Name="SecondaryPage" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28"><TextBlock x:Name="SecondaryKicker" Text="{DynamicResource Secondary.Kicker}" Foreground="#18D8F2" FontSize="10"/><TextBlock x:Name="SecondaryTitle" Text="{DynamicResource Secondary.Module}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="SecondarySubtitle" Foreground="#6D91A2" Margin="0,7,0,20"/><Border Style="{StaticResource CardStyle}" Padding="24"><TextBlock x:Name="SecondaryContent" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" LineHeight="23"/></Border></StackPanel></ScrollViewer></Grid>
        </Grid>
    </Grid>
</Window>
