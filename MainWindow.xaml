<Window x:Class="币安量化机器人.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPE · 合约交易智能体" MinWidth="1180" MinHeight="760"
        FontFamily="Microsoft YaHei" WindowStartupLocation="CenterScreen" Background="#F7F9FB">
    <Grid Margin="10">
        <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#17212B" CornerRadius="8" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="WPE · 交易智能体" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="TopStageText" Text="未启动" Foreground="#AFC1D1" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="EnvironmentText" Foreground="#DCE8F1" Margin="0,0,20,4"/>
                    <TextBlock x:Name="AccountTopText" Foreground="#DCE8F1" Margin="0,0,20,4"/>
                    <TextBlock x:Name="BrainTopText" Foreground="#DCE8F1" Margin="0,0,20,4"/>
                    <TextBlock x:Name="CycleText" Foreground="#7ED6A5" Margin="0,0,12,4"/>
                </WrapPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="启动" Height="34" MinWidth="72" Margin="6,0,0,0" Click="StartAgent_Click"/>
                    <Button x:Name="PauseButton" Content="暂停" Height="34" MinWidth="72" Margin="6,0,0,0" Click="PauseAgent_Click"/>
                    <Button Content="停止" Height="34" MinWidth="72" Margin="6,0,0,0" Click="StopAgent_Click"/>
                    <Button x:Name="EmergencyButton" Content="紧急全平" Height="34" MinWidth="86" Margin="10,0,0,0" Background="#B33A3A" Foreground="White" FontWeight="Bold" Click="EmergencyClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" Margin="8,8,12,8" Background="#EAF0F4" CornerRadius="8">
            <StackPanel Margin="12">
                <TextBlock Text="智能体工作区" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <Separator/>
                <Button Content="总览" Tag="总览" Height="42" Margin="0,8,0,0" Click="NavButton_Click"/>
                <Button Content="市场与证据" Tag="市场证据" Height="42" Margin="0,8,0,0" Click="NavButton_Click"/>
                <Button Content="持仓与订单" Tag="持仓订单" Height="42" Margin="0,8,0,0" Click="NavButton_Click"/>
                <Button Content="风控与设置" Tag="风控设置" Height="42" Margin="0,8,0,0" Click="NavButton_Click"/>
                <Button Content="账户与大脑" Tag="账户大脑" Height="42" Margin="0,8,0,0" Click="NavButton_Click"/>
                <Button Content="运行日志" Tag="日志" Height="42" Margin="0,8,0,0" Click="NavButton_Click"/>
                <Border Background="#DDE7ED" CornerRadius="6" Padding="9" Margin="0,20,0,0">
                    <TextBlock Text="身体执行确定性规则；当前唯一大脑负责判断。主网未经独立确认无法启动。" TextWrapping="Wrap" Foreground="#52616D" FontSize="11"/>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Margin="0,8,0,8" Background="White" BorderBrush="#D7E0E7" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#F1F5F8" Padding="12"><TextBlock x:Name="SectionTitle" Text="智能体总览" FontSize="16" FontWeight="Bold"/></Border>
                <Grid Grid.Row="1" x:Name="MainContentHost"/>
            </Grid>
        </Border>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="2" Background="#EAF0F4">
            <StatusBarItem><TextBlock x:Name="StatusText" Text="状态：就绪"/></StatusBarItem>
            <StatusBarItem><TextBlock x:Name="AgentStatusText" Margin="18,0,0,0" Foreground="#52616D"/></StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right"><TextBlock Text="WPE Agent · 默认 Testnet" Foreground="#52616D"/></StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
