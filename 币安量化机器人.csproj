<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<OutputType>WinExe</OutputType>
		<UseWPF>true</UseWPF>

		<!-- 代码质量（按需留） -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>3.6.0</Version>
		<AssemblyVersion>3.6.0.0</AssemblyVersion>
		<FileVersion>3.6.0.0</FileVersion>

		<!-- 防止与手动 AssemblyInfo.cs 冲突 -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<!-- 项目仅在 Windows 上运行，忽略 Windows 平台互操作性规则 CA1416 -->
		<NoWarn>$(NoWarn);CA1416;CS0579</NoWarn>
	</PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ScottPlot.WPF" Version="5.0.56" />
      <PackageReference Include="Binance.Net" Version="8.3.0" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.4" />
      <PackageReference Include="Serilog" Version="2.12.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="3.1.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
      <PackageReference Include="CryptoExchange.Net" Version="8.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Data\ai\lstm_model.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Resources\i18n\*.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <ItemGroup>
      <!-- 旧占位测试保留在仓库中，但不再作为生产 WPF 源码编译。 -->
      <Compile Remove="Tests\**\*.cs" />
      <Compile Remove="Tools\WpeLicenseGenerator\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Tools\IntegrationChecker\" />
    </ItemGroup>

    <ItemGroup>
      <None Include=".github\workflows\dotnet.yml" />
    </ItemGroup>

</Project>
