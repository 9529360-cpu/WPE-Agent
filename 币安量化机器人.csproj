<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
		<OutputType Condition="'$(TargetFramework)' == 'net8.0'">Library</OutputType>
		<OutputType Condition="'$(TargetFramework)' == 'net8.0-windows'">WinExe</OutputType>
		<UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWPF>

		<!-- 代码质量（按需留） -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Authoritative product SemVer. Runtime, plugins, reports and packaging read the generated assembly version. -->
		<Version>3.6.0</Version>
		<AssemblyVersion>3.6.0.0</AssemblyVersion>
		<FileVersion>3.6.0.0</FileVersion>
		<AssemblyTitle>WPE Agent</AssemblyTitle>
		<AssemblyName>WPE-Agent</AssemblyName>
		<Product>WPE Agent Multi-Exchange</Product>
		<Company>WPE</Company>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
		<DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>

		<!-- 项目仅在 Windows 上运行，忽略 Windows 平台互操作性规则 CA1416 -->
		<NoWarn>$(NoWarn);CA1416;CS0579</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="WebUi\out\**\*" Condition="'$(TargetFramework)' == 'net8.0-windows'" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
      <PackageReference Include="ScottPlot.WPF" Version="5.0.56" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
      <PackageReference Include="Binance.Net" Version="8.3.0" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
      <PackageReference Include="System.Text.Json" Version="8.0.6" />
      <PackageReference Include="Serilog" Version="2.12.0" />
      <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
      <PackageReference Include="Serilog.Extensions.Logging" Version="3.1.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
      <PackageReference Include="CryptoExchange.Net" Version="8.0.0" />
      <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" Condition="'$(TargetFramework)' == 'net8.0'" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Data\ai\lstm_model.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="Resources\i18n\*.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </None>
      <None Update="Data\agent-settings*.json;Data\appsettings*.json;Data\order-state*.json;Data\**\*.db;Data\**\*.db-wal;Data\**\*.db-shm;Data\**\*.sqlite;Data\**\*.sqlite-wal;Data\**\*.sqlite-shm;Data\**\*.sqlite3;Data\**\*.sqlite3-wal;Data\**\*.sqlite3-shm;Data\**\*.log;logs\**\*;Logs\**\*;Tests\**\*;WPE.Tests\**\*">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </None>
      <Content Update="Data\agent-settings*.json;Data\appsettings*.json;Data\order-state*.json;Data\**\*.db;Data\**\*.db-wal;Data\**\*.db-shm;Data\**\*.sqlite;Data\**\*.sqlite-wal;Data\**\*.sqlite-shm;Data\**\*.sqlite3;Data\**\*.sqlite3-wal;Data\**\*.sqlite3-shm;Data\**\*.log;logs\**\*;Logs\**\*;Tests\**\*;WPE.Tests\**\*">
        <CopyToOutputDirectory>Never</CopyToOutputDirectory>
        <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
      <!-- Portable runtime target: compile production kernel/services without WPF presentation sources. -->
      <Compile Remove="**\*.xaml.cs" />
      <Compile Remove="AssemblyInfo.cs" />
      <Compile Remove="Modules\**\*.cs" />
      <Compile Remove="Controls\**\*.cs" />
      <Compile Remove="Converters\**\*.cs" />
      <Compile Remove="Helpers\StackPanelHelper.cs" />
      <Compile Remove="Services\Localization\WpfLocalizationBridge.cs" />
    </ItemGroup>

    <ItemGroup>
      <!-- 旧占位测试保留在仓库中，但不再作为生产 WPF 源码编译。 -->
      <Compile Remove="Tests\**\*.cs" />
      <Compile Remove="WPE.Tests\**\*.cs" />
      <None Remove="WPE.Tests\**\*" />
      <Compile Remove="Tools\WpeLicenseGenerator\**\*.cs" />
      <Compile Remove="Services\BinanceReadFacade.cs" />
      <Compile Remove="Services\AiForecastService.cs" />
      <Compile Remove="Infrastructure\Data\BinanceDataCollectionService.cs" />
      <!-- Dormant pre-production implementations retained only as migration references. -->
      <Compile Remove="Services\RiskEngine.cs" />
      <Compile Remove="Application\Backtesting\WalkForwardOptimizer.cs" />
      <Compile Remove="Infrastructure\Data\FileDataSource.cs" />
      <Compile Remove="Infrastructure\Data\DataQualityRules.cs" />
      <Compile Remove="Services\Agent\AgentMemoryStore.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
      <!-- Legacy Binance-bound desktop modules are migration references, not production UI. -->
      <Compile Remove="Modules\Account\AccountFundsView.xaml.cs" />
      <Compile Remove="Modules\AI\ModelHub.xaml.cs" />
      <Compile Remove="Modules\Market\FundingView.xaml.cs" />
      <Compile Remove="Modules\Market\RealtimeView.xaml.cs" />
      <Compile Remove="Modules\Research\BacktestView.xaml.cs" />
      <Compile Remove="Modules\Risk\RiskCenterView.xaml.cs" />
      <Compile Remove="Modules\Trade\PositionsOrdersView.xaml.cs" />
      <Compile Remove="Modules\Alert\AlertCenterView.xaml.cs" />
      <Compile Remove="Services\NotificationService.cs" />
      <Page Remove="Modules\Account\AccountFundsView.xaml" />
      <Page Remove="Modules\AI\ModelHub.xaml" />
      <Page Remove="Modules\Market\FundingView.xaml" />
      <Page Remove="Modules\Market\RealtimeView.xaml" />
      <Page Remove="Modules\Research\BacktestView.xaml" />
      <Page Remove="Modules\Risk\RiskCenterView.xaml" />
      <Page Remove="Modules\Trade\PositionsOrdersView.xaml" />
      <Page Remove="Modules\Alert\AlertCenterView.xaml" />
      <None Include="Modules\Account\AccountFundsView.xaml" />
      <None Include="Modules\AI\ModelHub.xaml" />
      <None Include="Modules\Market\FundingView.xaml" />
      <None Include="Modules\Market\RealtimeView.xaml" />
      <None Include="Modules\Research\BacktestView.xaml" />
      <None Include="Modules\Risk\RiskCenterView.xaml" />
      <None Include="Modules\Trade\PositionsOrdersView.xaml" />
      <None Include="Modules\Alert\AlertCenterView.xaml" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Tools\IntegrationChecker\" />
    </ItemGroup>

    <ItemGroup>
      <None Include=".github\workflows\dotnet.yml" />
    </ItemGroup>

</Project>
