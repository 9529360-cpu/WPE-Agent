<Window x:Class="币安量化机器人.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Setup.Title}" Width="1180" Height="780" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#050A0F" Foreground="#D9EEF5">
    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0B1821"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#D9EEF5"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#8A6726"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF7E6"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0B1821"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#D9EEF5"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#718993"/>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="CaretBrush" Value="#E9BD63"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5,12,12"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="CaretBrush" Value="#E9BD63"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5,12,12"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,12,12"/></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3A2E1D"/><Setter Property="Foreground" Value="#FFF4D9"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#8A6726"/><Setter Property="Foreground" Value="#FFF7E6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#718993"/></Trigger></Style.Triggers></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D9EEF5"/></Style>
        <Style TargetType="TabControl"><Setter Property="Background" Value="#08141C"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="BorderBrush" Value="#244A5A"/></Style>
        <Style TargetType="TabItem"><Setter Property="Foreground" Value="#C7EAF4"/><Setter Property="Background" Value="#102733"/></Style>
        <Style TargetType="ListView"><Setter Property="Background" Value="#08141C"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="BorderBrush" Value="#244A5A"/></Style>
        <Style TargetType="ListViewItem"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D9EEF5"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3A2E1D"/><Setter Property="Foreground" Value="#FFF7E6"/></Trigger></Style.Triggers></Style>
        <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#102733"/><Setter Property="Foreground" Value="#C7EAF4"/><Setter Property="BorderBrush" Value="#244A5A"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#102733"/><Setter Property="Foreground" Value="#C7EAF4"/><Setter Property="BorderBrush" Value="#2B6173"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#07131B" BorderBrush="#183A49" BorderThickness="0,0,1,0" Padding="25"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="WPE // ACCESS" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Setup.Subtitle}" Foreground="#5E899B" Margin="0,7,0,28"/></StackPanel><StackPanel Grid.Row="1"><Button Tag="0" Click="Nav_Click"><TextBlock><Run Text="01  "/><Run Text="{DynamicResource Setup.StepEnvironment}"/></TextBlock></Button><Button Tag="1" Click="Nav_Click"><TextBlock><Run Text="02  "/><Run Text="{DynamicResource Setup.StepExchange}"/></TextBlock></Button><Button Tag="2" Click="Nav_Click"><TextBlock><Run Text="03  "/><Run Text="{DynamicResource Setup.StepBrain}"/></TextBlock></Button><Button Tag="3" Click="Nav_Click"><TextBlock><Run Text="04  "/><Run Text="{DynamicResource Setup.StepHealth}"/></TextBlock></Button><Button Tag="4" Click="Nav_Click"><TextBlock><Run Text="05  "/><Run Text="{DynamicResource Setup.StepConfirm}"/></TextBlock></Button><Button Tag="5" Click="Nav_Click"><TextBlock><Run Text="06  "/><Run Text="{DynamicResource Setup.StepAdvanced}"/></TextBlock></Button><Button Tag="6" Click="Nav_Click"><TextBlock><Run Text="07  "/><Run Text="{DynamicResource Notification.Title}"/></TextBlock></Button></StackPanel><StackPanel Grid.Row="2"><TextBlock x:Name="UserText" Foreground="#35E6A0"/><TextBlock Text="{DynamicResource Setup.LocalSession}" Foreground="#547D8D" FontSize="10" Margin="0,6,0,0"/></StackPanel></Grid></Border>
        <Grid Grid.Column="1" Margin="36,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Setup.Title}" FontSize="28" FontWeight="SemiBold"/><Button x:Name="LanguageButton" Content="{DynamicResource Language.Button}" HorizontalAlignment="Right" Click="Language_Click"/></Grid>
            <TabControl x:Name="WizardTabs" Grid.Row="1" Margin="0,22,0,16" Background="Transparent" Foreground="#D9EEF5" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="Header" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TabControl.Resources>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.EnvironmentTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.EnvironmentHelp}" Foreground="#678C9C" Margin="0,7,0,24"/><TextBlock Text="{DynamicResource Setup.Environment}"/><ComboBox x:Name="EnvironmentBox" SelectionChanged="Environment_Changed"><ComboBoxItem Content="{DynamicResource Setup.EnvironmentFuturesTestnet}" Tag="FuturesTestnet" IsSelected="True"/><ComboBoxItem Content="{DynamicResource Setup.EnvironmentSpotTestnet}" Tag="SpotTestnet" IsEnabled="False"/><ComboBoxItem Content="{DynamicResource Setup.EnvironmentPaper}" Tag="Paper" IsEnabled="False"/><ComboBoxItem Content="{DynamicResource Setup.EnvironmentMainnet}" Tag="Mainnet" IsEnabled="False"/></ComboBox><Border Background="#10221F" BorderBrush="#245E50" BorderThickness="1" CornerRadius="8" Padding="16"><TextBlock Text="{DynamicResource Setup.TestnetNotice}" Foreground="#65DDB0"/></Border><TextBlock Text="{DynamicResource Authorization.ModeTitle}" FontSize="17" FontWeight="SemiBold" Margin="0,24,0,2"/><TextBlock Text="{DynamicResource Authorization.ModeHelp}" Foreground="#678C9C" Margin="0,0,0,8"/><ComboBox x:Name="AuthorizationModeBox" SelectionChanged="AuthorizationMode_Changed"><ComboBoxItem Content="{DynamicResource Authorization.Research}" Tag="Research"/><ComboBoxItem Content="{DynamicResource Authorization.Signal}" Tag="Signal"/><ComboBoxItem Content="{DynamicResource Authorization.Review}" Tag="Review"/><ComboBoxItem x:Name="AutoAuthorizationItem" Content="{DynamicResource Authorization.AutoTestnet}" Tag="Auto"/></ComboBox><TextBlock x:Name="AuthorizationModeHint" Foreground="#65DDB0" Margin="0,0,0,10"/><TextBlock Text="{DynamicResource Authorization.Reason}"/><TextBox x:Name="AuthorizationReasonBox" MaxLength="240"/><Button Content="{DynamicResource Authorization.SaveMode}" HorizontalAlignment="Left" Click="SaveAuthorizationMode_Click"/><TextBlock x:Name="AuthorizationModeStatus" Foreground="#FFAA4C" Margin="5,8"/><Border Background="#08141C" BorderBrush="#1C4655" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,24,0,0"><StackPanel><DockPanel Margin="0,0,0,10"><TextBlock Text="Pending review queue" FontSize="17" FontWeight="SemiBold" DockPanel.Dock="Left"/><Button x:Name="RefreshPendingReviewButton" Content="Refresh" HorizontalAlignment="Right" Click="RefreshPendingReviews_Click"/></DockPanel><ListView x:Name="PendingReviewList" Height="220" SelectionChanged="PendingReviewList_SelectionChanged" Margin="0,0,0,10"><ListView.View><GridView><GridViewColumn Header="Approval" Width="180" DisplayMemberBinding="{Binding ApprovalId}"/><GridViewColumn Header="Status" Width="120" DisplayMemberBinding="{Binding Status}"/><GridViewColumn Header="Created" Width="150" DisplayMemberBinding="{Binding CreatedDisplay}"/><GridViewColumn Header="Expires" Width="150" DisplayMemberBinding="{Binding ExpiresDisplay}"/><GridViewColumn Header="Reason code" Width="220" DisplayMemberBinding="{Binding ReasonCode}"/></GridView></ListView.View></ListView><TextBlock Text="Review action reason"/><TextBox x:Name="PendingReviewReasonBox" MaxLength="240"/><StackPanel Orientation="Horizontal"><Button x:Name="ApprovePendingReviewButton" Content="Approve" Click="ApprovePendingReview_Click"/><Button x:Name="RejectPendingReviewButton" Content="Reject" Click="RejectPendingReview_Click"/><Button x:Name="RevokePendingReviewButton" Content="Revoke" Click="RevokePendingReview_Click"/></StackPanel><TextBlock x:Name="PendingReviewStatusText" Foreground="#FFAA4C" Margin="5,8"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.ExchangeTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.SecretHelp}" Foreground="#678C9C" Margin="0,7,0,12"/><Button Content="{DynamicResource ExchangeManager.Open}" HorizontalAlignment="Left" Margin="0,0,0,16" Click="OpenExchangeManager_Click"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Setup.ApiKey}"/><PasswordBox x:Name="ApiKeyBox"/><TextBlock x:Name="ApiKeyHint" Foreground="#547D8D"/><TextBlock Text="{DynamicResource Setup.ApiSecret}" Margin="0,12,0,0"/><PasswordBox x:Name="ApiSecretBox"/><TextBlock x:Name="ApiSecretHint" Foreground="#547D8D"/><CheckBox x:Name="RevealExchangeCheck" Content="{DynamicResource Access.ShowSecret}" Margin="0,12,0,3" Checked="RevealExchange_Changed" Unchecked="RevealExchange_Changed"/><TextBlock Text="{DynamicResource Access.Reauthorize}" Foreground="#547D8D"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Setup.BinanceApiBase}"/><TextBox x:Name="ApiBaseBox"/><TextBlock Text="{DynamicResource Setup.Proxy}"/><CheckBox x:Name="ProxyCheck" Content="{DynamicResource Setup.UseProxy}" Margin="0,8"/><TextBox x:Name="ProxyBox"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="{DynamicResource Setup.ReceiveWindow}"/><TextBox x:Name="ReceiveWindowBox"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Setup.Timeout}"/><TextBox x:Name="ExchangeTimeoutBox"/></StackPanel></UniformGrid></StackPanel></Grid><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Setup.Save}" Click="SaveExchange_Click"/><Button Content="{DynamicResource Setup.TestConnection}" Click="TestExchange_Click"/><Button Content="{DynamicResource Access.DeleteCredential}" Click="DeleteExchange_Click"/></StackPanel><TextBlock x:Name="ExchangeStatus" Foreground="#FFAA4C" Margin="5,12"/></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.BrainTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.BrainHelp}" Foreground="#678C9C" Margin="0,7,0,22"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Setup.Provider}"/><ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed"><ComboBoxItem Content="DeepSeek" IsSelected="True"/><ComboBoxItem Content="OpenAI Compatible"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Anthropic"/><ComboBoxItem Content="Local Ollama"/><ComboBoxItem Content="Custom API"/></ComboBox><TextBlock Text="{DynamicResource Setup.ApiBase}"/><TextBox x:Name="BrainEndpointBox"/><TextBlock Text="{DynamicResource Setup.ApiKey}"/><PasswordBox x:Name="BrainKeyBox"/><TextBlock x:Name="BrainKeyHint" Foreground="#547D8D"/><CheckBox x:Name="RevealBrainCheck" Content="{DynamicResource Access.ShowSecret}" Margin="0,10,0,3" Checked="RevealBrain_Changed" Unchecked="RevealBrain_Changed"/><TextBlock Text="{DynamicResource Setup.Model}" Margin="0,10,0,0"/><TextBox x:Name="BrainModelBox"/></StackPanel><StackPanel Grid.Column="1"><UniformGrid Columns="2"><StackPanel><TextBlock Text="{DynamicResource Setup.MaxTokens}"/><TextBox x:Name="MaxTokenBox"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Setup.Temperature}"/><TextBox x:Name="TemperatureBox"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Setup.Timeout}"/><TextBox x:Name="BrainTimeoutBox"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Setup.Retry}"/><TextBox x:Name="RetryBox"/></StackPanel></UniformGrid><TextBlock Text="{DynamicResource Setup.PromptVersion}"/><TextBox x:Name="PromptVersionBox"/><TextBlock Text="{DynamicResource Setup.ContextLimit}"/><TextBox x:Name="ContextLimitBox"/><CheckBox x:Name="LocalBrainCheck" Content="{DynamicResource Setup.LocalModel}" Margin="0,8"/><CheckBox x:Name="FallbackCheck" Content="{DynamicResource Setup.Fallback}" Margin="0,5"/></StackPanel></Grid><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Setup.Save}" Click="SaveBrain_Click"/><Button Content="{DynamicResource Setup.TestConnection}" Click="TestBrain_Click"/><Button Content="{DynamicResource Access.DeleteCredential}" Click="DeleteBrain_Click"/></StackPanel><TextBlock x:Name="BrainStatus" Foreground="#FFAA4C" Margin="5,12"/></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.HealthTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.HealthHelp}" Foreground="#678C9C" Margin="0,7,0,20"/><Button Content="{DynamicResource Setup.CheckAll}" HorizontalAlignment="Left" Click="CheckAll_Click"/><Border Background="#091820" BorderBrush="#1C4655" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,15,0,0"><TextBlock x:Name="HealthText" FontFamily="Consolas" FontSize="13" LineHeight="24"/></Border></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.ConfirmTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.ConfirmHelp}" Foreground="#678C9C" Margin="0,7,0,24"/><Border Background="#1D1710" BorderBrush="#7A4F22" BorderThickness="1" CornerRadius="10" Padding="18"><TextBlock Text="{DynamicResource Setup.MainnetWarning}" Foreground="#FFB260"/></Border><CheckBox x:Name="RiskConfirmBox" Content="{DynamicResource Setup.RiskConfirm}" Margin="0,25,0,10" FontSize="14"/><TextBlock x:Name="FinishStatus" Foreground="#FFAA4C" Margin="0,8"/></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.AdvancedTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.AdvancedHelp}" Foreground="#678C9C" Margin="0,7,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Setup.Symbols}"/><TextBox x:Name="SymbolsBox"/><CheckBox x:Name="RealtimeDataCheck" Content="{DynamicResource Setup.RealtimeData}" Margin="0,8"/><CheckBox x:Name="NewsDataCheck" Content="{DynamicResource Setup.NewsData}" Margin="0,8"/><CheckBox x:Name="NotificationCheck" Content="{DynamicResource Setup.LocalNotification}" Margin="0,8"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Setup.Leverage}"/><TextBox x:Name="LeverageBox"/><TextBlock Text="{DynamicResource Setup.TradeRisk}"/><TextBox x:Name="TradeRiskBox"/><TextBlock Text="{DynamicResource Setup.AccountExposure}"/><TextBox x:Name="AccountExposureBox"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="{DynamicResource Setup.Save}" Click="SaveAdvanced_Click"/><Button Content="{DynamicResource Setup.Backup}" Click="Backup_Click"/><Button Content="{DynamicResource Setup.Restore}" Click="Restore_Click"/><Button Content="{DynamicResource Setup.OpenLogs}" Click="OpenLogs_Click"/></StackPanel><TextBlock x:Name="AdvancedStatus" Foreground="#FFAA4C" Margin="5,12"/></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Notification.Title}" FontSize="23"/><TextBlock Text="{DynamicResource Notification.Help}" Foreground="#678C9C" Margin="0,7,0,16"/><CheckBox x:Name="NotificationsEnabledBox" Content="{DynamicResource Notification.Enabled}" Margin="0,4,0,12"/><TextBlock Text="{DynamicResource Notification.Events}"/><WrapPanel Margin="0,5,0,12"><CheckBox x:Name="NotifyOrderFilled" Content="Order filled" Tag="OrderFilled" Margin="0,4,18,4"/><CheckBox x:Name="NotifyPositionOpened" Content="Position opened" Tag="PositionOpened" Margin="0,4,18,4"/><CheckBox x:Name="NotifyPositionClosed" Content="Position closed" Tag="PositionClosed" Margin="0,4,18,4"/><CheckBox x:Name="NotifyProtection" Content="Protection changes" Tag="ProtectionUpdated" Margin="0,4,18,4"/><CheckBox x:Name="NotifyProtectionFailed" Content="Protection failed" Tag="ProtectionFailed" Margin="0,4,18,4"/><CheckBox x:Name="NotifyRiskBlocked" Content="Risk blocked" Tag="RiskBlocked" Margin="0,4,18,4"/><CheckBox x:Name="NotifyAgentDegraded" Content="Agent degraded" Tag="AgentDegraded" Margin="0,4,18,4"/><CheckBox x:Name="NotifyTest" Content="Test" Tag="Test" Margin="0,4,18,4"/></WrapPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="QuietHoursBox" Content="{DynamicResource Notification.QuietHours}" Margin="0,10,18,8"/><TextBox x:Name="QuietStartBox" Grid.Column="1" ToolTip="Start (HH:mm)"/><TextBox x:Name="QuietEndBox" Grid.Column="2" ToolTip="End (HH:mm)"/><ComboBox x:Name="QuietTimeZoneBox" Grid.Column="3" IsEditable="True"/></Grid><TabControl Margin="0,8,0,8"><TabItem Header="Telegram"><StackPanel Margin="12"><CheckBox x:Name="TelegramEnabledBox" Content="{DynamicResource Notification.ChannelEnabled}"/><TextBlock Text="{DynamicResource Notification.Token}"/><PasswordBox x:Name="TelegramTokenBox"/><TextBlock x:Name="TelegramTokenHint" Foreground="#547D8D"/><TextBlock Text="{DynamicResource Notification.Destination}"/><PasswordBox x:Name="TelegramDestinationBox"/><TextBlock x:Name="TelegramDestinationHint" Foreground="#547D8D"/><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Setup.Save}" Click="SaveNotifications_Click"/><Button Content="{DynamicResource Notification.TestSend}" Click="TestTelegram_Click"/><Button Content="{DynamicResource Notification.Clear}" Click="ClearTelegram_Click"/></StackPanel></StackPanel></TabItem><TabItem Header="WhatsApp"><StackPanel Margin="12"><CheckBox x:Name="WhatsAppEnabledBox" Content="{DynamicResource Notification.ChannelEnabled}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Notification.Token}"/><PasswordBox x:Name="WhatsAppTokenBox"/><TextBlock x:Name="WhatsAppTokenHint" Foreground="#547D8D"/><TextBlock Text="{DynamicResource Notification.Destination}"/><PasswordBox x:Name="WhatsAppDestinationBox"/><TextBlock x:Name="WhatsAppDestinationHint" Foreground="#547D8D"/><TextBlock Text="{DynamicResource Notification.PhoneNumberId}"/><PasswordBox x:Name="WhatsAppPhoneNumberIdBox"/><TextBlock x:Name="WhatsAppPhoneNumberIdHint" Foreground="#547D8D"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Notification.Template}"/><TextBox x:Name="WhatsAppTemplateBox"/><TextBlock Text="{DynamicResource Notification.Language}"/><TextBox x:Name="WhatsAppLanguageBox"/><TextBlock Text="API version"/><TextBox x:Name="WhatsAppApiVersionBox"/></StackPanel></Grid><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Setup.Save}" Click="SaveNotifications_Click"/><Button Content="{DynamicResource Notification.TestSend}" Click="TestWhatsApp_Click"/><Button Content="{DynamicResource Notification.Clear}" Click="ClearWhatsApp_Click"/></StackPanel></StackPanel></TabItem></TabControl><TextBlock x:Name="NotificationStatus" Foreground="#FFAA4C" Margin="5,8"/></StackPanel></ScrollViewer></TabItem>
            </TabControl>
            <Grid Grid.Row="2"><Button Content="{DynamicResource Setup.Previous}" HorizontalAlignment="Left" Click="Previous_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Setup.Next}" Click="Next_Click"/><Button Content="{DynamicResource Setup.Enter}" Background="#0B6070" BorderBrush="#18D8F2" Click="Finish_Click"/></StackPanel></Grid>
        </Grid>
    </Grid>
</Window>
