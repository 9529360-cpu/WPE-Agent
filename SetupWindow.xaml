<Window x:Class="币安量化机器人.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Setup.Title}" Width="1180" Height="780" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#050A0F" Foreground="#D9EEF5">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5,12,12"/></Style><Style TargetType="PasswordBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5,12,12"/></Style><Style TargetType="ComboBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#0A1117"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,12,12"/></Style><Style TargetType="Button"><Setter Property="Background" Value="#102733"/><Setter Property="Foreground" Value="#C7EAF4"/><Setter Property="BorderBrush" Value="#2B6173"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#07131B" BorderBrush="#183A49" BorderThickness="0,0,1,0" Padding="25"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="WPE // ACCESS" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Setup.Subtitle}" Foreground="#5E899B" Margin="0,7,0,28"/></StackPanel><StackPanel Grid.Row="1"><Button Tag="0" Click="Nav_Click"><TextBlock><Run Text="01  "/><Run Text="{DynamicResource Setup.StepEnvironment}"/></TextBlock></Button><Button Content="02  BINANCE API" Tag="1" Click="Nav_Click"/><Button Content="03  AI BRAIN" Tag="2" Click="Nav_Click"/><Button Tag="3" Click="Nav_Click"><TextBlock><Run Text="04  "/><Run Text="{DynamicResource Setup.StepHealth}"/></TextBlock></Button><Button Tag="4" Click="Nav_Click"><TextBlock><Run Text="05  "/><Run Text="{DynamicResource Setup.StepConfirm}"/></TextBlock></Button><Button Tag="5" Click="Nav_Click"><TextBlock><Run Text="06  "/><Run Text="{DynamicResource Setup.StepAdvanced}"/></TextBlock></Button></StackPanel><StackPanel Grid.Row="2"><TextBlock x:Name="UserText" Foreground="#35E6A0"/><TextBlock Text="{DynamicResource Setup.LocalSession}" Foreground="#547D8D" FontSize="10" Margin="0,6,0,0"/></StackPanel></Grid></Border>
        <Grid Grid.Column="1" Margin="36,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="{DynamicResource Setup.Title}" FontSize="28" FontWeight="SemiBold"/><Button x:Name="LanguageButton" Content="{DynamicResource Language.Button}" HorizontalAlignment="Right" Click="Language_Click"/></Grid>
            <TabControl x:Name="WizardTabs" Grid.Row="1" Margin="0,22,0,16" Background="Transparent" BorderThickness="0"><TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.EnvironmentTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.EnvironmentHelp}" Foreground="#678C9C" Margin="0,7,0,24"/><TextBlock Text="{DynamicResource Setup.Environment}"/><ComboBox x:Name="EnvironmentBox" SelectionChanged="Environment_Changed"><ComboBoxItem Content="Binance Futures Testnet" Tag="FuturesTestnet" IsSelected="True"/><ComboBoxItem Content="Binance Spot Testnet" Tag="SpotTestnet" IsEnabled="False"/><ComboBoxItem Content="Paper Trading" Tag="Paper" IsEnabled="False"/><ComboBoxItem Content="Mainnet" Tag="Mainnet" IsEnabled="False"/></ComboBox><Border Background="#10221F" BorderBrush="#245E50" BorderThickness="1" CornerRadius="8" Padding="16"><TextBlock Text="{DynamicResource Setup.TestnetNotice}" Foreground="#65DDB0"/></Border></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.ExchangeTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.SecretHelp}" Foreground="#678C9C" Margin="0,7,0,22"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="API Key"/><PasswordBox x:Name="ApiKeyBox"/><TextBlock x:Name="ApiKeyHint" Foreground="#547D8D"/><TextBlock Text="API Secret" Margin="0,12,0,0"/><PasswordBox x:Name="ApiSecretBox"/><TextBlock x:Name="ApiSecretHint" Foreground="#547D8D"/><CheckBox x:Name="RevealExchangeCheck" Content="{DynamicResource Access.ShowSecret}" Margin="0,12,0,3" Checked="RevealExchange_Changed" Unchecked="RevealExchange_Changed"/><TextBlock Text="{DynamicResource Access.Reauthorize}" Foreground="#547D8D"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Setup.BinanceApiBase}"/><TextBox x:Name="ApiBaseBox"/><TextBlock Text="{DynamicResource Setup.Proxy}"/><CheckBox x:Name="ProxyCheck" Content="{DynamicResource Setup.UseProxy}" Margin="0,8"/><TextBox x:Name="ProxyBox"/><UniformGrid Columns="2"><StackPanel><TextBlock Text="{DynamicResource Setup.ReceiveWindow}"/><TextBox x:Name="ReceiveWindowBox"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Setup.Timeout}"/><TextBox x:Name="ExchangeTimeoutBox"/></StackPanel></UniformGrid></StackPanel></Grid><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Setup.Save}" Click="SaveExchange_Click"/><Button Content="{DynamicResource Setup.TestConnection}" Click="TestExchange_Click"/><Button Content="{DynamicResource Access.DeleteCredential}" Click="DeleteExchange_Click"/></StackPanel><TextBlock x:Name="ExchangeStatus" Foreground="#FFAA4C" Margin="5,12"/></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.BrainTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.BrainHelp}" Foreground="#678C9C" Margin="0,7,0,22"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Setup.Provider}"/><ComboBox x:Name="ProviderBox" SelectionChanged="Provider_Changed"><ComboBoxItem Content="DeepSeek" IsSelected="True"/><ComboBoxItem Content="OpenAI Compatible"/><ComboBoxItem Content="OpenAI"/><ComboBoxItem Content="Anthropic"/><ComboBoxItem Content="Local Ollama"/><ComboBoxItem Content="Custom API"/></ComboBox><TextBlock Text="{DynamicResource Setup.ApiBase}"/><TextBox x:Name="BrainEndpointBox"/><TextBlock Text="API Key"/><PasswordBox x:Name="BrainKeyBox"/><TextBlock x:Name="BrainKeyHint" Foreground="#547D8D"/><CheckBox x:Name="RevealBrainCheck" Content="{DynamicResource Access.ShowSecret}" Margin="0,10,0,3" Checked="RevealBrain_Changed" Unchecked="RevealBrain_Changed"/><TextBlock Text="{DynamicResource Setup.Model}" Margin="0,10,0,0"/><TextBox x:Name="BrainModelBox"/></StackPanel><StackPanel Grid.Column="1"><UniformGrid Columns="2"><StackPanel><TextBlock Text="{DynamicResource Setup.MaxTokens}"/><TextBox x:Name="MaxTokenBox"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Setup.Temperature}"/><TextBox x:Name="TemperatureBox"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Setup.Timeout}"/><TextBox x:Name="BrainTimeoutBox"/></StackPanel><StackPanel><TextBlock Text="{DynamicResource Setup.Retry}"/><TextBox x:Name="RetryBox"/></StackPanel></UniformGrid><TextBlock Text="{DynamicResource Setup.PromptVersion}"/><TextBox x:Name="PromptVersionBox"/><TextBlock Text="{DynamicResource Setup.ContextLimit}"/><TextBox x:Name="ContextLimitBox"/><CheckBox x:Name="LocalBrainCheck" Content="{DynamicResource Setup.LocalModel}" Margin="0,8"/><CheckBox x:Name="FallbackCheck" Content="{DynamicResource Setup.Fallback}" Margin="0,5"/></StackPanel></Grid><StackPanel Orientation="Horizontal"><Button Content="{DynamicResource Setup.Save}" Click="SaveBrain_Click"/><Button Content="{DynamicResource Setup.TestConnection}" Click="TestBrain_Click"/><Button Content="{DynamicResource Access.DeleteCredential}" Click="DeleteBrain_Click"/></StackPanel><TextBlock x:Name="BrainStatus" Foreground="#FFAA4C" Margin="5,12"/></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.HealthTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.HealthHelp}" Foreground="#678C9C" Margin="0,7,0,20"/><Button Content="{DynamicResource Setup.CheckAll}" HorizontalAlignment="Left" Click="CheckAll_Click"/><Border Background="#091820" BorderBrush="#1C4655" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,15,0,0"><TextBlock x:Name="HealthText" FontFamily="Consolas" FontSize="13" LineHeight="24"/></Border></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.ConfirmTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.ConfirmHelp}" Foreground="#678C9C" Margin="0,7,0,24"/><Border Background="#1D1710" BorderBrush="#7A4F22" BorderThickness="1" CornerRadius="10" Padding="18"><TextBlock Text="{DynamicResource Setup.MainnetWarning}" Foreground="#FFB260"/></Border><CheckBox x:Name="RiskConfirmBox" Content="{DynamicResource Setup.RiskConfirm}" Margin="0,25,0,10" FontSize="14"/><TextBlock x:Name="FinishStatus" Foreground="#FFAA4C" Margin="0,8"/></StackPanel></ScrollViewer></TabItem>
                <TabItem><ScrollViewer><StackPanel Margin="8"><TextBlock Text="{DynamicResource Setup.AdvancedTitle}" FontSize="23"/><TextBlock Text="{DynamicResource Setup.AdvancedHelp}" Foreground="#678C9C" Margin="0,7,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Setup.Symbols}"/><TextBox x:Name="SymbolsBox"/><CheckBox x:Name="RealtimeDataCheck" Content="{DynamicResource Setup.RealtimeData}" Margin="0,8"/><CheckBox x:Name="NewsDataCheck" Content="{DynamicResource Setup.NewsData}" Margin="0,8"/><CheckBox x:Name="NotificationCheck" Content="{DynamicResource Setup.LocalNotification}" Margin="0,8"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Setup.Leverage}"/><TextBox x:Name="LeverageBox"/><TextBlock Text="{DynamicResource Setup.TradeRisk}"/><TextBox x:Name="TradeRiskBox"/><TextBlock Text="{DynamicResource Setup.AccountExposure}"/><TextBox x:Name="AccountExposureBox"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="{DynamicResource Setup.Save}" Click="SaveAdvanced_Click"/><Button Content="{DynamicResource Setup.Backup}" Click="Backup_Click"/><Button Content="{DynamicResource Setup.Restore}" Click="Restore_Click"/><Button Content="{DynamicResource Setup.OpenLogs}" Click="OpenLogs_Click"/></StackPanel><TextBlock x:Name="AdvancedStatus" Foreground="#FFAA4C" Margin="5,12"/></StackPanel></ScrollViewer></TabItem>
            </TabControl>
            <Grid Grid.Row="2"><Button Content="{DynamicResource Setup.Previous}" HorizontalAlignment="Left" Click="Previous_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{DynamicResource Setup.Next}" Click="Next_Click"/><Button Content="{DynamicResource Setup.Enter}" Background="#0B6070" BorderBrush="#18D8F2" Click="Finish_Click"/></StackPanel></Grid>
        </Grid>
    </Grid>
</Window>
