<Window x:Class="币安量化机器人.LoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Access.LoginTitle}" Width="1180" Height="720" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="#050A0F" Foreground="#D7EBF3">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D7EBF3"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D7EBF3"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#102733"/><Setter Property="Foreground" Value="#BFEAF5"/><Setter Property="BorderBrush" Value="#2A6274"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
    </Window.Resources>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="560"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#07131B" BorderBrush="#173847" BorderThickness="0,0,1,0"><Grid Margin="58"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Center"><Grid Width="92" Height="92" HorizontalAlignment="Left"><Ellipse Fill="#0B2935" Stroke="#18D8F2" StrokeThickness="2"/><Ellipse Width="22" Height="22" Fill="#18D8F2"><Ellipse.Effect><DropShadowEffect Color="#18D8F2" BlurRadius="28" ShadowDepth="0"/></Ellipse.Effect></Ellipse></Grid><TextBlock Text="WPE // SENTINEL" FontSize="30" FontWeight="SemiBold" Margin="0,28,0,0"/><TextBlock Text="{DynamicResource Access.LoginSubtitle}" Foreground="#6997AA" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/><Border Background="#091C25" BorderBrush="#1D4857" BorderThickness="1" CornerRadius="10" Margin="0,35,0,0" Padding="16"><StackPanel><TextBlock Text="{DynamicResource Access.TestnetDefault}" Foreground="#35E6A0"/><TextBlock Text="{DynamicResource Access.LocalOnly}" Foreground="#698B9A" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel><TextBlock Grid.Row="1" Text="{DynamicResource Access.VersionLabel}" Foreground="#456B7C" FontFamily="Consolas"/></Grid></Border>
        <Grid Grid.Column="1" Margin="55,40"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="ModeTitle" Text="{DynamicResource Access.SignIn}" FontSize="27" FontWeight="SemiBold" DockPanel.Dock="Left"/><Button x:Name="LanguageButton" Content="{DynamicResource Language.Button}" DockPanel.Dock="Right" Click="Language_Click"/></DockPanel>
            <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Access.UserName}" Foreground="#6F98A9"/><TextBox x:Name="UserBox" Margin="0,7,0,17"/><TextBlock Text="{DynamicResource Access.Password}" Foreground="#6F98A9"/><PasswordBox x:Name="PasswordBox" Margin="0,7,0,12"/><TextBlock x:Name="ExtraLabel" Text="{DynamicResource Access.ConfirmPassword}" Foreground="#6F98A9" Visibility="Collapsed"/><PasswordBox x:Name="ExtraBox" Margin="0,7,0,12" Visibility="Collapsed"/><TextBlock x:Name="RecoveryLabel" Text="{DynamicResource Access.RecoveryCode}" Foreground="#6F98A9" Visibility="Collapsed"/><TextBox x:Name="RecoveryBox" Margin="0,7,0,12" Visibility="Collapsed"/><CheckBox x:Name="RememberBox" Content="{DynamicResource Access.Remember}" IsChecked="True" Margin="0,4,0,18"/><Button x:Name="PrimaryButton" Content="{DynamicResource Access.SignInButton}" Background="#0B6070" BorderBrush="#18D8F2" FontWeight="SemiBold" Click="Primary_Click"/><TextBlock x:Name="StatusText" Foreground="#FFAA4C" TextWrapping="Wrap" Margin="4,12,4,0"/></StackPanel>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="{DynamicResource Access.SignIn}" Tag="login" Click="Mode_Click"/><Button Content="{DynamicResource Access.Create}" Tag="create" Click="Mode_Click"/><Button Content="{DynamicResource Access.Reset}" Tag="reset" Click="Mode_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
