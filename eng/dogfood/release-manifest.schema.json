{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wpe.dogfood-release-manifest/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "sourceIdentity", "environment", "configurationSchema", "migrationVersion", "createdUtc", "files", "gates", "probeScript"],
  "properties": {
    "schemaVersion": { "const": "wpe.dogfood-release-manifest/1.0" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$" },
    "sourceIdentity": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._/-]{0,127}$" },
    "environment": { "const": "Testnet" },
    "configurationSchema": { "type": "string", "minLength": 1, "maxLength": 64 },
    "migrationVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "createdUtc": { "type": "string", "format": "date-time" },
    "probeScript": { "type": "string", "pattern": "^[^:\\\\]+\\.ps1$" },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "length"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "length": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "gates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
