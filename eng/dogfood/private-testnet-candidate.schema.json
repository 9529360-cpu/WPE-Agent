{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wpe.private-testnet-candidate/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "createdUtc", "localOnly", "commercialDistribution", "mainnet", "payloadManifestSha256", "probeScript", "files"],
  "properties": {
    "schemaVersion": { "const": "wpe.private-testnet-candidate/1.0" },
    "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]{0,63}$" },
    "createdUtc": { "type": "string", "format": "date-time" },
    "localOnly": { "const": true },
    "commercialDistribution": { "const": false },
    "mainnet": { "const": false },
    "payloadManifestSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "probeScript": { "type": "string", "pattern": "^[^:\\\\]+\\.ps1$" },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "length"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "length": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
