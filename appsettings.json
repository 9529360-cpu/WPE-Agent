{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 30
        }
      },
      {
        "Name": "Console"
      }
    ]
  },
  "TradingEngine": {
    "Enabled": true,
    "CycleIntervalSeconds": 60,
    "MaxConcurrentOrders": 5,
    "OrderTimeoutSeconds": 30,
    "RetryPolicy": {
      "MaxRetries": 3,
      "BackoffMultiplier": 2.0
    }
  },
  "Risk": {
    "MaxDrawdownPercent": 20,
    "MinMarginRatioPercent": 50,
    "MaxLeveragePerPosition": 10,
    "MaxTotalExposurePercent": 100,
    "StopLossPercent": 5,
    "TakeProfitPercent": 10,
    "LiquidationWarningThreshold": 0.2
  },
  "DataCollection": {
    "Enabled": true,
    "UpdateIntervalSeconds": 10,
    "DefaultSymbols": [
      "BTCUSDT",
      "ETHUSDT"
    ],
    "KlineIntervals": [
      "1m",
      "5m",
      "15m",
      "1h",
      "4h",
      "1d"
    ],
    "OrderBookDepth": 20,
    "RecentTradesLimit": 100
  },
  "Strategy": {
    "EvaluationWindowDays": 30,
    "MinimumTradesForEvaluation": 10,
    "MinimumSharpeRatio": 0.5,
    "MaximumDrawdownPercent": 20,
    "MinimumWinRatePercent": 40
  },
  "Persistence": {
    "DatabasePath": "Data/trading.db",
    "BackupEnabled": true,
    "BackupIntervalDays": 7,
    "RetentionDays": 365
  },
  "Binance": {
    "ApiKey": "",
    "SecretKey": "",
    "TestnetMode": true,
    "BaseUrl": "https://testnet.binancefuture.com",
    "WebsocketUrl": "wss://stream.binancefuture.com"
  },
  "Notification": {
    "Enabled": true,
    "NotifyOnTrade": true,
    "NotifyOnError": true,
    "NotifyOnRiskWarning": true
  }
}
