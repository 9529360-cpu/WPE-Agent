<UserControl x:Class="币安量化机器人.Modules.Settings.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:币安量化机器人.Helpers">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="12" CornerRadius="6">
            <TextBlock Text="系统设置" FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,12" helpers:StackPanelHelper.Spacing="12">
            <CheckBox x:Name="ReconnectBox" Content="断线自动重连 WebSocket" FontSize="14"/>
            <CheckBox x:Name="NotificationBox" Content="启用通知推送" FontSize="14"/>
            <StackPanel Orientation="Horizontal" helpers:StackPanelHelper.Spacing="8">
                <TextBlock Text="运行环境" VerticalAlignment="Center"/>
                <ComboBox x:Name="EnvironmentBox" Width="140" Height="28">
                    <ComboBoxItem Content="Production"/>
                    <ComboBoxItem Content="Staging"/>
                    <ComboBoxItem Content="Development"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" helpers:StackPanelHelper.Spacing="8">
                <TextBlock Text="刷新频率(秒)" VerticalAlignment="Center"/>
                <TextBox x:Name="RefreshBox" Width="100" Height="28"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" helpers:StackPanelHelper.Spacing="8">
                <TextBlock Text="日志级别" VerticalAlignment="Center"/>
                <ComboBox x:Name="LogLevelBox" Width="140" Height="28">
                    <ComboBoxItem Content="Trace"/>
                    <ComboBoxItem Content="Debug"/>
                    <ComboBoxItem Content="Info"/>
                    <ComboBoxItem Content="Warning"/>
                    <ComboBoxItem Content="Error"/>
                </ComboBox>
            </StackPanel>
            <Button Content="保存设置" Width="120" Height="32" Click="Save_Click"/>
        </StackPanel>

        <StatusBar Grid.Row="2" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：未保存"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
