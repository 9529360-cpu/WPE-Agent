<UserControl x:Class="币安量化机器人.Modules.Optimize.WfoOptimizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：参数区 -->
        <Border Padding="12" BorderBrush="#E1E6EB" BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="参数优化 / 前向分析（WFO）" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <!-- 窗口与滚动设置 -->
                <GroupBox Header="窗口与滚动设置" Margin="0,6,0,0">
                    <StackPanel Margin="8">
                        <UniformGrid Rows="3" Columns="2" Margin="0,0,0,6">
                            <TextBlock Text="样本内(IS)天数"/>
                            <TextBox x:Name="TbIsLen" Text="365" Margin="4,0"/>
                            <TextBlock Text="样本外(OOS)天数"/>
                            <TextBox x:Name="TbOosLen" Text="90" Margin="4,0"/>
                            <TextBlock Text="滚动方式"/>
                            <ComboBox x:Name="CbRollMode" Margin="4,0" SelectedIndex="0">
                                <ComboBoxItem Content="滚动窗口（Rolling）"/>
                                <ComboBoxItem Content="锚定/扩展（Anchored）"/>
                            </ComboBox>
                        </UniformGrid>
                        <TextBlock Foreground="#6B778C" FontSize="12"
                                   Text="提示：IS:OOS 建议 2:1 或 3:1；IS 需覆盖目标市场周期。"/>
                    </StackPanel>
                </GroupBox>

                <!-- 目标函数 -->
                <GroupBox Header="优化目标" Margin="0,6,0,0">
                    <StackPanel Margin="8">
                        <UniformGrid Rows="1" Columns="2">
                            <TextBlock Text="目标函数"/>
                            <ComboBox x:Name="CbObjective" SelectedIndex="0" Margin="4,0">
                                <ComboBoxItem Content="最大化 夏普比（Sharpe）"/>
                                <ComboBoxItem Content="最大化 年化收益"/>
                                <ComboBoxItem Content="最小化 最大回撤"/>
                            </ComboBox>
                        </UniformGrid>
                        <TextBlock Foreground="#6B778C" FontSize="12"
                                   Text="注：夏普比有局限，注意样本频率与分布假设。"/>
                    </StackPanel>
                </GroupBox>

                <!-- 参数搜索空间（演示：双均线 ma_fast / ma_slow） -->
                <GroupBox Header="参数搜索空间" Margin="0,6,0,0">
                    <StackPanel Margin="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="参数名" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="最小值" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="最大值" FontWeight="Bold"/>
                            <TextBlock Grid.Column="3" Text="步长"   FontWeight="Bold"/>

                            <TextBox x:Name="TbP1Name" Grid.Row="1" Text="ma_fast" Margin="0,24,8,0"/>
                            <TextBox x:Name="TbP1Min"  Grid.Row="1" Grid.Column="1" Text="5"   Margin="0,24,8,0"/>
                            <TextBox x:Name="TbP1Max"  Grid.Row="1" Grid.Column="2" Text="35"  Margin="0,24,8,0"/>
                            <TextBox x:Name="TbP1Step" Grid.Row="1" Grid.Column="3" Text="5"   Margin="0,24,0,0"/>

                            <TextBox x:Name="TbP2Name" Grid.Row="2" Text="ma_slow" Margin="0,56,8,0"/>
                            <TextBox x:Name="TbP2Min"  Grid.Row="2" Grid.Column="1" Text="80"  Margin="0,56,8,0"/>
                            <TextBox x:Name="TbP2Max"  Grid.Row="2" Grid.Column="2" Text="180" Margin="0,56,8,0"/>
                            <TextBox x:Name="TbP2Step" Grid.Row="2" Grid.Column="3" Text="20"  Margin="0,56,0,0"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnRun" Content="启动优化" Width="100" Height="30" Click="BtnRun_Click"/>
                    <Button Content="清空结果" Margin="8,0,0,0" Width="100" Height="30" Click="BtnClear_Click"/>
                </StackPanel>

                <TextBlock x:Name="StatusText" Margin="0,8,0,0" Text="状态：就绪" Foreground="#6B778C"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="1" x:Name="Tabs">
                <TabItem Header="摘要结果">
                    <DataGrid x:Name="GridSummary" AutoGenerateColumns="True" CanUserAddRows="False"
                              IsReadOnly="True" Margin="6"/>
                </TabItem>
                <TabItem Header="稳定性检查">
                    <sp:WpfPlot x:Name="StabPlot" Margin="6"/>
                </TabItem>
                <TabItem Header="权益曲线">
                    <sp:WpfPlot x:Name="EquityPlot" Margin="6"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
