<UserControl x:Class="币安量化机器人.Modules.Risk.RiskCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:币安量化机器人.Helpers">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111827" Padding="12" CornerRadius="6">
            <DockPanel>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="风险控制中心" FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="基于 VaR / CVaR 的组合风险度量" Foreground="#CBD5F5" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" helpers:StackPanelHelper.Spacing="8">
                    <ComboBox x:Name="BenchmarkBox" Width="140" Height="28"/>
                    <Button Content="评估风险" Width="100" Height="28" Click="Evaluate_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="RiskGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="120"/>
                    <DataGridTextColumn Header="VaR" Binding="{Binding ValueAtRisk}" Width="120"/>
                    <DataGridTextColumn Header="CVaR" Binding="{Binding ConditionalVaR}" Width="120"/>
                    <DataGridTextColumn Header="波动率" Binding="{Binding Volatility}" Width="120"/>
                    <DataGridTextColumn Header="最大回撤" Binding="{Binding MaxDrawdown}" Width="120"/>
                    <DataGridTextColumn Header="杠杆" Binding="{Binding Leverage}" Width="80"/>
                    <DataGridTextColumn Header="清算价" Binding="{Binding LiquidationPrice}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="压力测试结果" FontWeight="Bold" FontSize="15"/>
                    <DataGrid x:Name="StressGrid" Margin="0,8,0,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="情景" Binding="{Binding Scenario}" Width="160"/>
                            <DataGridTextColumn Header="组合损益" Binding="{Binding PortfolioPnl}" Width="120"/>
                            <DataGridTextColumn Header="保证金占用" Binding="{Binding MarginUsage}" Width="120"/>
                            <DataGridTextColumn Header="触发概率" Binding="{Binding BreachProbability}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="RuleText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#4B5563"/>
                </StackPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：等待评估"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
