<UserControl x:Class="币安量化机器人.Modules.Trade.TradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:币安量化机器人.Helpers">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#0F172A" Padding="12" CornerRadius="6">
            <DockPanel>
                <TextBlock Text="交易执行" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" helpers:StackPanelHelper.Spacing="8">
                    <Button Content="刷新交易对" Width="100" Height="28" Click="RefreshSymbols_Click"/>
                    <Button Content="清空批量" Width="90" Height="28" Click="ClearBatch_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
            <StackPanel>
                <TextBlock Text="单笔下单" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="合约"/>
                    <ComboBox x:Name="SymbolBox" Height="28" IsEditable="True"/>
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="方向"/>
                    <ComboBox x:Name="SideBox" Height="28">
                        <ComboBoxItem Content="Buy"/>
                        <ComboBoxItem Content="Sell"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="订单类型"/>
                    <ComboBox x:Name="TypeBox" Height="28" SelectionChanged="TypeBox_SelectionChanged">
                        <ComboBoxItem Content="Market"/>
                        <ComboBoxItem Content="Limit"/>
                        <ComboBoxItem Content="StopLoss"/>
                        <ComboBoxItem Content="StopLossLimit"/>
                        <ComboBoxItem Content="TakeProfit"/>
                        <ComboBoxItem Content="TakeProfitLimit"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="数量"/>
                    <TextBox x:Name="QuantityBox" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="价格"/>
                    <TextBox x:Name="PriceBox" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="触发价"/>
                    <TextBox x:Name="StopPriceBox" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="有效期"/>
                    <ComboBox x:Name="TifBox" Height="28">
                        <ComboBoxItem Content="GTC"/>
                        <ComboBoxItem Content="IOC"/>
                        <ComboBoxItem Content="FOK"/>
                    </ComboBox>
                </StackPanel>
                <Button Content="提交订单" Margin="0,12,0,0" Height="32" Click="SubmitOrder_Click"/>
                <Button Content="加入批量" Margin="0,8,0,0" Height="30" Click="AddBatch_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="批量下单 / 并行执行" FontWeight="Bold" FontSize="15"/>
                <DataGrid x:Name="BatchGrid" Grid.Row="1" Margin="0,8,0,8" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="100"/>
                        <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="80"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="价格" Binding="{Binding Price}" Width="100"/>
                        <DataGridTextColumn Header="触发价" Binding="{Binding StopPrice}" Width="100"/>
                        <DataGridTextColumn Header="有效期" Binding="{Binding TimeInForce}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" helpers:StackPanelHelper.Spacing="8">
                    <Button Content="执行批量" Width="100" Height="30" Click="ExecuteBatch_Click"/>
                    <Button Content="移除选中" Width="100" Height="30" Click="RemoveSelected_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar Grid.Row="2" Grid.ColumnSpan="3" Background="#F1F5F9">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：等待操作"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
