<UserControl x:Class="币安量化机器人.Modules.Trade.PositionsOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:币安量化机器人.Helpers">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0B1120" Padding="12" CornerRadius="6">
            <DockPanel>
                <TextBlock Text="持仓与订单概览" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" helpers:StackPanelHelper.Spacing="8">
                    <Button Content="刷新数据" Width="100" Height="28" Click="Refresh_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,12,0,12">
            <TabItem Header="当前持仓">
                <DataGrid x:Name="PositionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="120"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding PositionAmt}" Width="120"/>
                        <DataGridTextColumn Header="开仓价" Binding="{Binding EntryPrice}" Width="120"/>
                        <DataGridTextColumn Header="标记价" Binding="{Binding MarkPrice}" Width="120"/>
                        <DataGridTextColumn Header="未实现盈亏" Binding="{Binding UnrealizedProfit}" Width="140"/>
                        <DataGridTextColumn Header="杠杆" Binding="{Binding Leverage}" Width="80"/>
                        <DataGridCheckBoxColumn Header="逐仓" Binding="{Binding IsIsolated}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="未完成订单">
                <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="120"/>
                        <DataGridTextColumn Header="订单号" Binding="{Binding OrderId}" Width="120"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120"/>
                        <DataGridTextColumn Header="价格" Binding="{Binding Price}" Width="120"/>
                        <DataGridTextColumn Header="成交量" Binding="{Binding ExecutedQuantity}" Width="120"/>
                        <DataGridTextColumn Header="成交额" Binding="{Binding CumulativeQuoteQuantity}" Width="120"/>
                        <DataGridTextColumn Header="更新时间" Binding="{Binding Time}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="最新成交">
                <DataGrid x:Name="TradesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="合约" Binding="{Binding Symbol}" Width="120"/>
                        <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="80"/>
                        <DataGridTextColumn Header="价格" Binding="{Binding Price}" Width="120"/>
                        <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="120"/>
                        <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：等待刷新"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
