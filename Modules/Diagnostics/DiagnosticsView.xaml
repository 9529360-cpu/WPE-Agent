<UserControl x:Class="币安量化机器人.Modules.Diagnostics.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:币安量化机器人.Helpers">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="12" CornerRadius="6">
            <TextBlock Text="诊断信息" FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,12,0,12" helpers:StackPanelHelper.Spacing="12">
            <TextBlock x:Name="EnvironmentText" FontSize="14" TextWrapping="Wrap"/>
            <TextBlock Text="日志输出" FontWeight="Bold"/>
            <TextBox x:Name="LogBox" Height="240" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"/>
            <Button Content="刷新" Width="120" Height="32" Click="Refresh_Click"/>
        </StackPanel>

        <GroupBox Grid.Row="2" Header="智能体事件时间线" Margin="0,0,0,8">
            <DataGrid x:Name="EventsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Timestamp}" Width="160"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                    <DataGridTextColumn Header="符号" Binding="{Binding Symbol}" Width="80"/>
                    <DataGridTextColumn Header="详情" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StatusBar Grid.Row="3" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：等待刷新"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
