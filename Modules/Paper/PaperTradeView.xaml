<UserControl x:Class="币安量化机器人.Modules.Paper.PaperTradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1F2937" Padding="12" CornerRadius="6">
            <DockPanel>
                <TextBlock Text="纸交易模拟" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="初始资金"/>
                <TextBox x:Name="InitialCapitalBox" Height="28" Text="10000"/>
                <TextBlock Text="标的价格" Margin="0,8,0,0"/>
                <TextBox x:Name="PriceBox" Height="28" Text="30000"/>
                <TextBlock Text="下单数量" Margin="0,8,0,0"/>
                <TextBox x:Name="QuantityBox" Height="28" Text="0.01"/>
                <TextBlock Text="手续费率" Margin="0,8,0,0"/>
                <TextBox x:Name="FeeRateBox" Height="28" Text="0.0004"/>
                <TextBlock Text="资金费率 (每小时)" Margin="0,8,0,0"/>
                <TextBox x:Name="FundingRateBox" Height="28" Text="0.0001"/>
                <Button Content="买入" Margin="0,12,0,0" Height="32" Click="Buy_Click"/>
                <Button Content="卖出" Margin="0,8,0,0" Height="32" Click="Sell_Click"/>
                <Button Content="重置" Margin="0,12,0,0" Height="32" Click="Reset_Click"/>
            </StackPanel>

            <DataGrid Grid.Column="2" x:Name="TradesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="160"/>
                    <DataGridTextColumn Header="方向" Binding="{Binding Side}" Width="80"/>
                    <DataGridTextColumn Header="价格" Binding="{Binding Price, StringFormat=F2}" Width="120"/>
                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity, StringFormat=F4}" Width="120"/>
                    <DataGridTextColumn Header="费用" Binding="{Binding Fee, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="资金费" Binding="{Binding Funding, StringFormat=F2}" Width="100"/>
                    <DataGridTextColumn Header="现金" Binding="{Binding Cash, StringFormat=F2}" Width="120"/>
                    <DataGridTextColumn Header="仓位" Binding="{Binding Position, StringFormat=F4}" Width="120"/>
                    <DataGridTextColumn Header="权益" Binding="{Binding Equity, StringFormat=F2}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StatusBar Grid.Row="2" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：模拟未启动"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
