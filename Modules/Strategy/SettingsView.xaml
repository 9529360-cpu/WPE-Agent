<UserControl x:Class="币安量化机器人.Modules.Strategy.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F5F7FA" Padding="12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="策略配置" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="组合基础参数、风险限制与算法开关，用于生成策略 JSON" Foreground="#6B7280" FontSize="12"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="加载默认参数" Margin="0,0,8,0" Height="28" Width="110" Click="LoadDefaults_Click"/>
                    <Button Content="新增参数" Height="28" Width="96" Click="AddParameter_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <GroupBox Header="基础信息" Margin="0,0,0,10">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="策略名称" Grid.Row="0"/>
                        <TextBox x:Name="StrategyNameBox" Grid.Row="0" Grid.Column="1" Margin="4"/>

                        <TextBlock Text="交易对" Grid.Row="1"/>
                        <TextBox x:Name="SymbolBox" Grid.Row="1" Grid.Column="1" Margin="4"/>

                        <TextBlock Text="时间框架" Grid.Row="2"/>
                        <ComboBox x:Name="TimeframeBox" Grid.Row="2" Grid.Column="1" Margin="4" SelectedIndex="0">
                            <ComboBoxItem Content="1m"/>
                            <ComboBoxItem Content="5m"/>
                            <ComboBoxItem Content="15m"/>
                            <ComboBoxItem Content="1h"/>
                            <ComboBoxItem Content="4h"/>
                            <ComboBoxItem Content="1d"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <GroupBox Header="资金与仓位" Margin="0,0,0,10">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="投入资金(USDT)" Grid.Row="0"/>
                        <TextBox x:Name="CapitalBox" Grid.Row="0" Grid.Column="1" Margin="4"/>

                        <TextBlock Text="杠杆" Grid.Row="1"/>
                        <Slider x:Name="LeverageSlider" Grid.Row="1" Grid.Column="1" Margin="4" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="3"/>

                        <TextBlock Text="最大持仓数" Grid.Row="2"/>
                        <TextBox x:Name="MaxPositionsBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="风险控制" Margin="0,0,0,10">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="止损%" Grid.Row="0"/>
                        <TextBox x:Name="StopLossBox" Grid.Row="0" Grid.Column="1" Margin="4"/>

                        <TextBlock Text="止盈%" Grid.Row="1"/>
                        <TextBox x:Name="TakeProfitBox" Grid.Row="1" Grid.Column="1" Margin="4"/>

                        <TextBlock Text="执行通道" Grid.Row="2"/>
                        <ComboBox x:Name="VenueBox" Grid.Row="2" Grid.Column="1" Margin="4" SelectedIndex="0">
                            <ComboBoxItem Content="Binance-UMFutures"/>
                            <ComboBoxItem Content="Binance-CMFutures"/>
                            <ComboBoxItem Content="模拟撮合引擎"/>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <GroupBox Header="算法开关" Margin="0,0,0,10">
                    <StackPanel Margin="0,8,0,0">
                        <CheckBox x:Name="AutoTradeToggle" Content="启用自动交易" Margin="0,4,0,0" IsChecked="True"/>
                        <CheckBox x:Name="HedgeToggle" Content="启用双向持仓 (Hedge Mode)" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <Button Content="保存配置" Width="110" Height="32" Click="SaveConfig_Click"/>
                    <Button Content="导出 JSON" Margin="8,0,0,0" Width="110" Height="32" Click="ExportConfig_Click"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10">
                <DockPanel>
                    <TextBlock Text="参数表" DockPanel.Dock="Top" FontWeight="Bold" FontSize="14" Margin="0,0,0,6"/>
                    <DataGrid x:Name="ParametersGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="参数" Binding="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="取值" Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            <DataGridTextColumn Header="说明" Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="#F5F7FA">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：尚未保存"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
