<UserControl x:Class="币安量化机器人.Modules.Alert.AlertCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1E293B" Padding="12" CornerRadius="6">
            <DockPanel>
                <TextBlock Text="预警与通知" FontSize="16" FontWeight="Bold" Foreground="White"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Telegram" Grid.Column="0" Margin="0,0,8,0">
                <StackPanel Margin="8">
                    <TextBlock Text="Bot Token"/>
                    <TextBox x:Name="TelegramTokenBox" Height="28" VerticalContentAlignment="Center"/>
                    <TextBlock Text="Chat Id" Margin="0,8,0,0"/>
                    <TextBox x:Name="TelegramChatBox" Height="28" VerticalContentAlignment="Center"/>
                    <Button Content="发送测试消息" Margin="0,12,0,0" Height="32" Click="SendTelegram_Click"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="钉钉 / Webhook" Grid.Column="1" Margin="8,0,0,0">
                <StackPanel Margin="8">
                    <TextBlock Text="Webhook Url"/>
                    <TextBox x:Name="WebhookBox" Height="28" VerticalContentAlignment="Center"/>
                    <TextBox x:Name="WebhookMessageBox" Margin="0,8,0,0" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <Button Content="发送测试消息" Margin="0,12,0,0" Height="32" Click="SendWebhook_Click"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：等待配置"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
