<UserControl x:Class="币安量化机器人.Modules.Account.ApiManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#1F2937" Padding="12" CornerRadius="6">
            <DockPanel>
                <TextBlock Text="API 管理" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <Button Content="加载" DockPanel.Dock="Right" Width="90" Height="28" Click="Load_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="AccountsGrid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="AccountsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="标签" Binding="{Binding Label}" Width="200"/>
                    <DataGridTextColumn Header="Key" Binding="{Binding MaskedKey}" Width="200"/>
                    <DataGridCheckBoxColumn Header="主账号" Binding="{Binding IsPrimary}" Width="80"/>
                    <DataGridCheckBoxColumn Header="纸交易" Binding="{Binding IsPaperTrading}" Width="80"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="新建 / 更新" FontWeight="Bold" FontSize="15"/>
                <TextBlock Text="标签" Margin="0,8,0,0"/>
                <TextBox x:Name="LabelBox" Height="28"/>
                <TextBlock Text="API Key" Margin="0,8,0,0"/>
                <TextBox x:Name="KeyBox" Height="28"/>
                <TextBlock Text="Secret" Margin="0,8,0,0"/>
                <PasswordBox x:Name="SecretBox" Height="28"/>
                <TextBlock Text="备注" Margin="0,8,0,0"/>
                <TextBox x:Name="NotesBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                <CheckBox x:Name="PrimaryBox" Content="主账号" Margin="0,8,0,0"/>
                <CheckBox x:Name="PaperBox" Content="纸交易" Margin="0,4,0,0"/>
                <Button Content="保存" Margin="0,12,0,0" Height="32" Click="Save_Click"/>
                <Button Content="设为当前凭证" Margin="0,8,0,0" Height="32" Click="Activate_Click"/>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="2" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：等待操作"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
