<UserControl x:Class="币安量化机器人.Modules.Account.AccountFundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0F172A" Padding="12" CornerRadius="6">
            <DockPanel>
                <TextBlock Text="账户资金概览" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <Button Content="刷新" DockPanel.Dock="Right" Width="90" Height="28" Click="Refresh_Click"/>
            </DockPanel>
        </Border>

        <DataGrid x:Name="BalanceGrid" Grid.Row="1" Margin="0,12,0,12" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="资产" Binding="{Binding Asset}" Width="120"/>
                <DataGridTextColumn Header="钱包余额" Binding="{Binding WalletBalance}" Width="160"/>
                <DataGridTextColumn Header="可用余额" Binding="{Binding AvailableBalance}" Width="160"/>
                <DataGridTextColumn Header="保证金余额" Binding="{Binding MarginBalance}" Width="160"/>
                <DataGridTextColumn Header="未实现盈亏" Binding="{Binding CrossUnrealizedPnl}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <StatusBar Grid.Row="2" Background="#E2E8F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="状态：等待刷新"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
