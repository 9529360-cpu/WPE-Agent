<Window x:Class="币安量化机器人.ExchangeManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource ExchangeManager.Title}" Width="1120" Height="760" MinWidth="980" MinHeight="650" WindowStartupLocation="CenterOwner" Background="#050A0F" Foreground="#D9EEF5">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,12,10"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D9EEF5"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,12,10"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#07131B"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,12,10"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#102733"/><Setter Property="Foreground" Value="#C7EAF4"/><Setter Property="BorderBrush" Value="#2B6173"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,7,14,7"/></Style>
    </Window.Resources>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="WPE // EXCHANGE ADAPTERS" FontSize="12" Foreground="#18D8F2"/><TextBlock Text="{DynamicResource ExchangeManager.Title}" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="{DynamicResource ExchangeManager.Subtitle}" Foreground="#678C9C" Margin="0,5,0,18"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#10221F" BorderBrush="#245E50" BorderThickness="1" CornerRadius="12" Padding="14,8"><TextBlock Text="{DynamicResource ExchangeManager.TestnetOnly}" Foreground="#65DDB0"/></Border></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="#07131B" BorderBrush="#183A49" BorderThickness="1" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{DynamicResource ExchangeManager.Connections}" FontSize="16" FontWeight="SemiBold"/><ListBox x:Name="ConnectionsList" Grid.Row="1" Margin="0,12" Background="#091820" Foreground="#D9EEF5" BorderBrush="#1C4655" DisplayMemberPath="DisplayName" SelectionChanged="ConnectionsList_SelectionChanged"/><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="{DynamicResource ExchangeManager.Add}" Click="Add_Click"/><Button Content="{DynamicResource ExchangeManager.Remove}" Click="Remove_Click"/></StackPanel></Grid></Border>
            <Border Grid.Column="2" Background="#07131B" BorderBrush="#183A49" BorderThickness="1" CornerRadius="12" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="{DynamicResource ExchangeManager.Provider}"/><ComboBox x:Name="ProviderBox" DisplayMemberPath="DisplayName" SelectionChanged="ProviderBox_SelectionChanged"/>
                <TextBlock Text="{DynamicResource ExchangeManager.ConnectionName}"/><TextBox x:Name="NameBox"/>
                <StackPanel Orientation="Horizontal"><CheckBox x:Name="EnabledCheck" Content="{DynamicResource ExchangeManager.Enabled}"/><CheckBox x:Name="ExecutionCheck" Content="{DynamicResource ExchangeManager.Execution}"/><CheckBox IsChecked="True" IsEnabled="False" Content="{DynamicResource ExchangeManager.Testnet}"/></StackPanel>
                <Border x:Name="AdapterStatusBorder" Background="#101E27" BorderBrush="#315467" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,5,12,14"><TextBlock x:Name="AdapterStatusText"/></Border>
                <TextBlock Text="{DynamicResource ExchangeManager.Endpoint}"/><TextBox x:Name="EndpointBox"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource ExchangeManager.SubAccount}"/><TextBox x:Name="SubAccountBox"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource ExchangeManager.Timeout}"/><TextBox x:Name="TimeoutBox"/></StackPanel></Grid>
                <CheckBox x:Name="ProxyCheck" Content="{DynamicResource ExchangeManager.Proxy}" Checked="Proxy_Changed" Unchecked="Proxy_Changed"/><TextBox x:Name="ProxyBox"/>
                <TextBlock Text="{DynamicResource ExchangeManager.Credentials}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/><StackPanel x:Name="CredentialPanel"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="{DynamicResource ExchangeManager.Save}" Click="Save_Click"/><Button Content="{DynamicResource ExchangeManager.Test}" Click="Test_Click"/><Button Content="{DynamicResource ExchangeManager.SetExecution}" Click="SetExecution_Click"/></StackPanel>
                <TextBlock x:Name="StatusText" Foreground="#FFB260" Margin="5,12" TextWrapping="Wrap"/>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0"><TextBlock Text="{DynamicResource ExchangeManager.Footer}" Foreground="#547D8D" VerticalAlignment="Center"/><Button Content="{DynamicResource ExchangeManager.Close}" HorizontalAlignment="Right" Click="Close_Click"/></Grid>
    </Grid>
</Window>
