{
  "version": "1.0.0",
  "localOnly": true,
  "privateTestnetPerOrderHumanApproval": false,
  "roles": [
    {
      "id": "market", "name": "Market", "mode": "deterministic", "runtime": "local",
      "deterministicFallback": "provider-facts-and-quality-gates",
      "allowedActions": ["collect", "validate", "publish-market"],
      "forbiddenActions": ["trade", "submitOrder", "bypassRiskGate"],
      "typedAuthorization": {"machineEvidenceGate": ["publish-market"], "machineRiskAuthorization": [], "machineExecutionEligibility": [], "automaticSafetyAction": [], "humanLifecycleGovernance": [], "humanExternalPublicationReview": []},
      "inputs": ["provider-market-data", "account-snapshot"], "outputs": ["canonical-market-evidence"]
    },
    {
      "id": "research", "name": "Research", "mode": "deterministic", "runtime": "local",
      "deterministicFallback": "canonical-evidence-research",
      "allowedActions": ["analyze", "validate", "publish-research"],
      "forbiddenActions": ["trade", "submitOrder", "bypassRiskGate"],
      "typedAuthorization": {"machineEvidenceGate": ["publish-research"], "machineRiskAuthorization": [], "machineExecutionEligibility": [], "automaticSafetyAction": [], "humanLifecycleGovernance": [], "humanExternalPublicationReview": []},
      "inputs": ["canonical-market-evidence", "news", "macro", "fundamental", "backtest"], "outputs": ["canonical-research-evidence"]
    },
    {
      "id": "strategy", "name": "Strategy", "mode": "deterministic", "runtime": "local",
      "deterministicFallback": "validated-strategy-lifecycle",
      "allowedActions": ["propose", "score", "publish-strategy"],
      "forbiddenActions": ["trade", "submitOrder", "bypassRiskGate"],
      "typedAuthorization": {"machineEvidenceGate": ["publish-strategy"], "machineRiskAuthorization": [], "machineExecutionEligibility": [], "automaticSafetyAction": [], "humanLifecycleGovernance": [], "humanExternalPublicationReview": []},
      "inputs": ["canonical-research-evidence", "strategy-registry"], "outputs": ["canonical-strategy-intent"]
    },
    {
      "id": "risk", "name": "Risk", "mode": "deterministic", "runtime": "local",
      "deterministicFallback": "fail-closed-risk-gate",
      "allowedActions": ["allow", "block", "limit", "halt"],
      "forbiddenActions": ["trade", "submitOrder", "bypassReliableOrderExecutor"],
      "typedAuthorization": {"machineEvidenceGate": [], "machineRiskAuthorization": ["allow"], "machineExecutionEligibility": [], "automaticSafetyAction": ["block", "halt"], "humanLifecycleGovernance": [], "humanExternalPublicationReview": []},
      "inputs": ["canonical-strategy-intent", "positions", "protections", "limits"], "outputs": ["canonical-risk-decision"]
    },
    {
      "id": "execution", "name": "Execution", "mode": "deterministic", "runtime": "local",
      "deterministicFallback": "reliable-order-executor-only",
      "allowedActions": ["prepare", "submit-via-executor", "cancel", "replace"],
      "forbiddenActions": ["direct-exchange-submit", "bypassRiskGate"],
      "typedAuthorization": {"machineEvidenceGate": [], "machineRiskAuthorization": [], "machineExecutionEligibility": ["submit-via-executor"], "automaticSafetyAction": [], "humanLifecycleGovernance": [], "humanExternalPublicationReview": []},
      "inputs": ["canonical-risk-decision"], "outputs": ["canonical-execution-result"],
      "mustRouteThrough": ["Risk Gate", "ReliableOrderExecutor"]
    },
    {
      "id": "recovery", "name": "Recovery", "mode": "deterministic", "runtime": "local",
      "deterministicFallback": "ledger-reconcile-no-resubmit",
      "allowedActions": ["reconcile", "quarantine", "repair", "escalate"],
      "forbiddenActions": ["trade", "submitOrder", "bypassRiskGate"],
      "typedAuthorization": {"machineEvidenceGate": ["reconcile"], "machineRiskAuthorization": [], "machineExecutionEligibility": [], "automaticSafetyAction": ["quarantine"], "humanLifecycleGovernance": [], "humanExternalPublicationReview": []},
      "inputs": ["canonical-execution-result", "order-ledger", "exchange-observations"], "outputs": ["canonical-recovery-result"]
    },
    {
      "id": "audit", "name": "Audit", "mode": "deterministic", "runtime": "local",
      "deterministicFallback": "append-only-canonical-audit",
      "allowedActions": ["verify", "record", "block", "degrade", "report"],
      "forbiddenActions": ["trade", "submitOrder", "bypassRiskGate"],
      "typedAuthorization": {"machineEvidenceGate": ["verify"], "machineRiskAuthorization": [], "machineExecutionEligibility": [], "automaticSafetyAction": ["block", "degrade"], "humanLifecycleGovernance": [], "humanExternalPublicationReview": ["report"]},
      "inputs": ["seven-role-canonical-chain"], "outputs": ["canonical-cycle-audit"]
    }
  ]
}
