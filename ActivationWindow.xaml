<Window x:Class="币安量化机器人.ActivationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Activation.Title}" Width="1120" Height="700" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#050A0F" Foreground="#D7EBF3">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0B1821"/><Setter Property="Foreground" Value="#D7EBF3"/><Setter Property="BorderBrush" Value="#244A5A"/><Setter Property="Padding" Value="12"/><Setter Property="FontFamily" Value="Consolas"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#102733"/><Setter Property="Foreground" Value="#BFEAF5"/><Setter Property="BorderBrush" Value="#2A6274"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
  </Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="470"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#07131B" BorderBrush="#173847" BorderThickness="0,0,1,0"><Grid Margin="52"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Center"><Grid Width="96" Height="96" HorizontalAlignment="Left"><Ellipse Fill="#0B2935" Stroke="#18D8F2" StrokeThickness="2"/><Ellipse Width="22" Height="22" Fill="#18D8F2"><Ellipse.Effect><DropShadowEffect Color="#18D8F2" BlurRadius="28" ShadowDepth="0"/></Ellipse.Effect></Ellipse></Grid><TextBlock Text="WPE // SENTINEL" FontSize="29" FontWeight="SemiBold" Margin="0,28,0,0"/><TextBlock Text="{DynamicResource Activation.Subtitle}" Foreground="#6997AA" FontSize="14" Margin="0,10,0,0" TextWrapping="Wrap"/><Border Background="#091C25" BorderBrush="#1D4857" BorderThickness="1" CornerRadius="10" Margin="0,32,0,0" Padding="16"><StackPanel><TextBlock Text="{DynamicResource Activation.Offline}" Foreground="#35E6A0"/><TextBlock Text="{DynamicResource Activation.OfflineHelp}" Foreground="#698B9A" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border></StackPanel><TextBlock Grid.Row="1" Text="WPE Agent 3.2 · DEVICE LICENSE" Foreground="#456B7C" FontFamily="Consolas"/></Grid></Border>
    <Grid Grid.Column="1" Margin="58,42"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="{DynamicResource Activation.Title}" FontSize="28" FontWeight="SemiBold"/><Button x:Name="LanguageButton" Content="{DynamicResource Language.Button}" DockPanel.Dock="Right" Click="Language_Click"/></DockPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource Activation.DeviceCode}" Foreground="#6F98A9"/><TextBox x:Name="DeviceCodeBox" IsReadOnly="True" Margin="0,8,0,5" FontSize="13"/><Button Content="{DynamicResource Activation.CopyDevice}" HorizontalAlignment="Left" Click="CopyDevice_Click"/><TextBlock Text="{DynamicResource Activation.Code}" Foreground="#6F98A9" Margin="0,22,0,0"/><TextBox x:Name="ActivationCodeBox" AcceptsReturn="True" TextWrapping="Wrap" Height="132" Margin="0,8,0,12" VerticalScrollBarVisibility="Auto"/><Button Content="{DynamicResource Activation.Activate}" Background="#0B6070" BorderBrush="#18D8F2" FontWeight="SemiBold" Click="Activate_Click"/><TextBlock x:Name="StatusText" Foreground="#FFAA4C" TextWrapping="Wrap" Margin="5,12,5,0"/></StackPanel><TextBlock Grid.Row="2" Text="{DynamicResource Activation.ProtectCode}" Foreground="#557C8C" TextWrapping="Wrap"/></Grid>
  </Grid>
</Window>
